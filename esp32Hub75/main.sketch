static const char INDEX_HTML[] PROGMEM = R"HTML(
<!doctype html><html><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>ESP32 HUB75 64x32</title>
<style>
:root{
  --bg:#ece8df;
  --bg-panel:#fffdf7;
  --ink:#101010;
  --muted:#5e5a51;
  --border:#bdb6aa;
  --accent:#ff5a1f;
  --accent-soft:#ffe9db;
  --warn:#ffd23d;
  --danger:#ff4d3a;
  --shadow:0 16px 32px rgba(20, 20, 20, 0.14);
  --radius:20px;
  --mono:"Space Mono","IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono","Courier New",monospace;
  --sans:"Inter","Helvetica Neue",system-ui,Arial,sans-serif;
}
*{box-sizing:border-box}
body{
  font-family:var(--sans);
  margin:0;
  background:
    radial-gradient(circle at 20% -10%, #fff7ef 0%, transparent 45%),
    radial-gradient(circle at 110% 20%, #f5f0e6 0%, transparent 35%),
    var(--bg);
  color:var(--ink);
}
header{
  padding:18px 22px;
  background:var(--bg-panel);
  border-bottom:2px solid var(--ink);
  display:flex;
  gap:18px;
  align-items:center;
  justify-content:space-between;
  flex-wrap:wrap;
  position:sticky;
  top:0;
  z-index:10;
}
.brand{display:flex;flex-direction:column;gap:4px}
.brand-title{
  font-family:var(--mono);
  font-size:23px;
  letter-spacing:0.2em;
  text-transform:uppercase;
}
.brand-sub{
  font-family:var(--mono);
  font-size:11px;
  letter-spacing:0.12em;
  text-transform:uppercase;
  color:var(--muted);
}
.header-pills{display:flex;gap:10px;flex-wrap:wrap}
.pill{
  background:#fff;
  padding:6px 12px;
  border-radius:999px;
  font-size:11px;
  border:2px solid var(--ink);
  font-family:var(--mono);
  letter-spacing:0.08em;
  text-transform:uppercase;
}
#wrap{
  display:grid;
  grid-template-columns:minmax(280px, 1fr) minmax(320px, 560px);
  gap:20px;
  padding:22px;
}
canvas{
  image-rendering:pixelated;
  background:#0b0b0b;
  border:2px solid var(--ink);
  border-radius:var(--radius);
  background-image:linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
  box-shadow:var(--shadow);
}
.panel{
  background:var(--bg-panel);
  border:2px solid var(--ink);
  border-radius:var(--radius);
  padding:16px;
  box-shadow:var(--shadow);
}
.panel-title{
  font-family:var(--mono);
  text-transform:uppercase;
  letter-spacing:0.12em;
  font-size:12px;
  color:var(--ink);
  margin-bottom:12px;
  display:flex;
  align-items:center;
  gap:8px;
}
.panel-title::before{
  content:"";
  width:10px;
  height:10px;
  border-radius:50%;
  background:var(--accent);
  border:2px solid var(--ink);
}
.panel-meta{
  font-family:var(--mono);
  font-size:11px;
  color:var(--muted);
  margin-top:10px;
}
.swatch{
  width:22px;
  height:22px;
  border-radius:8px;
  border:1px solid var(--border);
  cursor:pointer;
  box-shadow:inset 0 0 0 1px rgba(0,0,0,0.25);
}
.swatch.selected{outline:2px solid var(--accent);outline-offset:2px}
button{
  background:var(--ink);
  color:#fffdf8;
  border:2px solid var(--ink);
  border-radius:12px;
  padding:10px 14px;
  cursor:pointer;
  font-family:var(--mono);
  text-transform:uppercase;
  letter-spacing:0.08em;
  font-size:11px;
  box-shadow:0 3px 0 rgba(0,0,0,0.35);
  transform:translateY(0);
}
button:hover{background:var(--accent);border-color:var(--ink)}
button:active{transform:translateY(2px);box-shadow:0 1px 0 rgba(0,0,0,0.3)}
.btn-danger{background:var(--danger);color:#fff}
.btn-warn{background:var(--warn);color:#111}
.btn-secondary{
  background:#fff;
  color:var(--ink);
  border:2px solid var(--ink);
}
.btn-secondary:hover{background:#f2eee6;border-color:var(--ink)}
input[type="color"]{
  width:44px;
  height:44px;
  border:1px solid var(--border);
  border-radius:12px;
  background:#fff;
  cursor:pointer;
}
input[type="file"]{max-width:100%}
select{
  background:#fff;
  color:var(--ink);
  border:2px solid var(--ink);
  border-radius:12px;
  padding:10px 12px;
  font-family:var(--mono);
  text-transform:uppercase;
  letter-spacing:0.06em;
  font-size:11px;
}
input[type="range"]{width:230px}
.row{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin:12px 0}
label{
  font-family:var(--mono);
  font-size:11px;
  text-transform:uppercase;
  letter-spacing:0.08em;
  color:var(--muted);
}
small{color:var(--muted);line-height:1.5}
#status{font-weight:700}
.ok{color:#2d9a59}.bad{color:#c73a2a}
progress{width:100%;height:14px;accent-color:var(--accent)}
#err{white-space:pre-wrap;color:#c73a2a;font-size:12px;margin-top:8px}
#info{margin-top:8px}
.badge{
  font-size:10px;
  border:2px solid var(--ink);
  border-radius:999px;
  padding:4px 8px;
  background:#fff;
  font-family:var(--mono);
  letter-spacing:0.08em;
  text-transform:uppercase;
}
hr{border:none;border-top:2px dashed var(--border);margin:18px 0}
.val{font-variant-numeric:tabular-nums;min-width:52px;display:inline-block}
a{color:var(--accent)}
.section-header{display:flex;align-items:center;justify-content:space-between;gap:10px}
.section-title{
  font-family:var(--mono);
  text-transform:uppercase;
  letter-spacing:0.12em;
  font-size:12px;
  margin-bottom:6px;
}
.workflow-row{margin-top:12px}
#workflowStatus[data-state="busy"]{background:var(--warn)}
#workflowStatus[data-state="done"]{background:#baf3c8}
#workflowStatus[data-state="error"]{background:#ffc7c0}
@media (max-width: 980px){
  #wrap{grid-template-columns:1fr}
}
</style>
</head><body>
<header>
  <div class="brand">
    <div class="brand-title">HUB75 Steuerung</div>
    <div class="brand-sub">ESP32 64×32 Interface</div>
  </div>
  <div class="header-pills">
    <div class="pill">64×32 Pixelart + Bilder + GIF</div>
    <div class="pill">WS: <span id="status">connecting…</span></div>
    <div class="pill">Host: <span id="host"></span></div>
    <div class="pill"><span class="badge">Panel: 64×32 (2:1)</span></div>
  </div>
</header>

<div id="wrap">
  <div class="panel panel--canvas">
    <div class="panel-title">Canvas</div>
    <canvas id="c"></canvas>
    <div class="panel-meta">Raster‑Preview · 64×32 · Live‑Panel‑Sync</div>
  </div>

  <div class="panel">
    <div class="section-title">Pixelart‑Editor</div>
    <div class="row">
      <label>Color</label>
      <input id="col" type="color" value="#ffcc00">
      <div id="palette" class="row" style="margin:0"></div>
      <label>Brush</label>
      <select id="brush">
        <option value="1" selected>1×1</option>
        <option value="2">2×2</option>
        <option value="3">3×3</option>
        <option value="4">4×4</option>
      </select>
      <button id="clear" type="button">Clear</button>
      <button id="fill" type="button" class="btn-warn">Fill</button>
      <button id="reinit" type="button" class="btn-danger">Reinit</button>
      <button id="redrawPanel" type="button">Redraw Panel</button>
      <button id="savePixelart" type="button">Save</button>
      <button id="loadPixelart" type="button">Load</button>
    </div>

    <div class="row">
      <span class="badge">Frame <span id="pixAnimFramePos">1/1</span></span>
      <button id="pixAnimPrev" type="button" class="btn-secondary">Prev</button>
      <button id="pixAnimNext" type="button" class="btn-secondary">Next</button>
      <button id="pixAnimAdd" type="button">Add Frame</button>
      <button id="pixAnimDelete" type="button" class="btn-warn">Delete Frame</button>
    </div>

    <div class="row">
      <label for="pixAnimSpeed">Frame‑Speed</label>
      <input id="pixAnimSpeed" type="range" min="30" max="1000" step="10" value="180">
      <span class="val" id="pixAnimSpeedVal">180 ms</span>
      <button id="pixAnimPlay" type="button">Play Pixelart Loop</button>
      <button id="pixAnimStop" type="button" class="btn-secondary">Stop Loop</button>
    </div>

    <small>
      Pixelart: Click/Drag · Right-Click = Erase (black).<br/>
      Brush malt ein Quadrat um den Cursor (zentriert).<br/>
      Beim Zeichnen/Frames senden wird Animation automatisch gestoppt.<br/>
      Neuer Frame startet immer mit dem Inhalt des vorherigen Frames.
    </small>

    <div class="row workflow-row">
      <span class="badge">Workflow</span>
      <span id="workflowStatus" class="badge">Idle</span>
      <button id="quickSync" type="button" class="btn-secondary">Quick Sync Panel</button>
      <button id="quickPreviewSend" type="button" class="btn-secondary">Preview + Send Bild</button>
    </div>

    <hr>

    <div>
      <div class="section-header">
        <div class="section-title">Bild / GIF Tuning</div>
        <span class="badge">Bilder + GIF</span>
      </div>

      <div class="row">
        <label>Gamma</label>
        <input id="gamma" type="range" min="50" max="260" value="120">
        <span class="val" id="gammaVal">1.20</span>

        <label>Boost</label>
        <input id="boost" type="range" min="50" max="200" value="110">
        <span class="val" id="boostVal">1.10</span>
      </div>

      <div class="row">
        <label>Brightness</label>
        <input id="brightness" type="range" min="5" max="255" value="5">
        <span class="val" id="brightnessVal">5</span>
      </div>

      <small>
        Gamma (≈0.5–2.6) korrigiert die Helligkeitskurve, Boost ist ein linearer Gain.
        Alles per LUT (schnell).
      </small>
    </div>

    <hr>

    <div>
      <div class="section-header">
        <div class="section-title">Uhr / Stopuhr (NTP)</div>
        <span class="badge">Display‑Modus</span>
      </div>

      <div class="row">
        <label for="displayMode">Modus</label>
