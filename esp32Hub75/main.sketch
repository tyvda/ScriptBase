static void schedule_fixed_interval(uint32_t &nextMs, uint32_t now, uint16_t intervalMs) {
  if (intervalMs == 0) intervalMs = 1;
  if (nextMs == 0) {
    nextMs = now + intervalMs;
    return;
  }
  do {
    nextMs += intervalMs;
  } while ((int32_t)(now - nextMs) >= 0);
}

