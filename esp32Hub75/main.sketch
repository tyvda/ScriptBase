static uint8_t clamp_u8(int value, uint8_t minValue, uint8_t maxValue) {
  if (value < minValue) return minValue;
  if (value > maxValue) return maxValue;
  return (uint8_t)value;
}

static uint16_t clamp_u16(int value, uint16_t minValue, uint16_t maxValue) {
  if (value < minValue) return minValue;
  if (value > maxValue) return maxValue;
  return (uint16_t)value;
}

static bool json_read_u8_clamped(JsonVariantConst value, uint8_t &target, uint8_t minValue, uint8_t maxValue) {
  if (!value.is<int>()) return false;
  target = clamp_u8(value.as<int>(), minValue, maxValue);
  return true;
}

static bool json_read_u16_clamped(JsonVariantConst value, uint16_t &target, uint16_t minValue, uint16_t maxValue) {
  if (!value.is<int>()) return false;
  target = clamp_u16(value.as<int>(), minValue, maxValue);
  return true;
}

// =====================
// WEB
// =====================
AsyncWebServer server(80);
AsyncWebSocket ws("/ws");

// Full-frame binary RX: ['F'] + 4096 bytes RGB565 little-endian
static uint8_t frame_rx[1 + (PANEL_RES_X * PANEL_RES_Y * 2)];
static constexpr size_t frame_rx_expected = sizeof(frame_rx);

// =====================
// Animation file (uploaded from browser)
// =====================
static const char* ANIM_PATH = "/anim.bin";
static volatile bool animPlaying = false;

#pragma pack(push, 1)
struct AnimHeader {
  char     magic[4];    // "A64x"
  uint8_t  w;           // 64
  uint8_t  h;           // 32
  uint16_t frames;      // number of frames
  uint8_t  loop;        // 1=loop
  uint8_t  reserved[7];
};
#pragma pack(pop)

struct PixelartUpload {
  File file;
  size_t size = 0;
  bool tooLarge = false;
  bool failed = false;
};

static File animFile;
static AnimHeader animHdr{};
static uint16_t animFrameIndex = 0;
static uint32_t animNextMs = 0;

