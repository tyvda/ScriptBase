        <input id="clockIntensity" type="range" min="10" max="255" value="255">
        <span class="val" id="clockIntensityVal">255</span>
      </div>

      <div class="row">
        <button id="stopwatchStart" type="button">Start</button>
        <button id="stopwatchStop" type="button" class="btn-secondary">Stop</button>
        <button id="stopwatchReset" type="button">Reset</button>

        <label for="stopwatchColor">Kette</label>
        <input id="stopwatchColor" type="color" value="#00ff00">
      </div>

      <div class="row">
        <label for="sleepEnabled">Schlafzeit</label>
        <select id="sleepEnabled">
          <option value="on" selected>An</option>
          <option value="off">Aus</option>
        </select>

        <label for="sleepStart">Start</label>
        <input id="sleepStart" type="time" value="23:00">

        <label for="sleepEnd">Ende</label>
        <input id="sleepEnd" type="time" value="06:00">
      </div>

      <div class="row">
        <label for="sleepDim">Schlaf‑Dimmung</label>
        <input id="sleepDim" type="range" min="0" max="20" value="10">
        <span class="val" id="sleepDimVal">10%</span>
      </div>

      <small>
        Uhr holt die Zeit per NTP. Optional Wetterdaten für Koblenz im Uhr‑Modus. Stopuhr zeigt HH:MM:SS und lässt eine LED‑Kette pro Minute umlaufen.
        Schlafzeit wird in LittleFS gespeichert und bleibt nach Stromausfall erhalten.
      </small>
    </div>

    <hr>

    <div>
      <div class="section-title">Bild (PNG/JPG/WebP) → 64×32</div>
      <input id="imgFile" type="file" accept="image/*">
      <div class="row">
        <label for="srcAspectImg">Quelle</label>
        <select id="srcAspectImg">
          <option value="auto" selected>Auto</option>
          <option value="4:3">4:3</option>
          <option value="16:9">16:9</option>
        </select>

        <label for="scaleModeImg">Mapping</label>
        <select id="scaleModeImg">
          <option value="cover" selected>Cover (Crop)</option>
          <option value="contain">Contain (Letterbox)</option>
        </select>
      </div>
      <div class="row">
        <button id="previewImg" type="button">Preview</button>
        <button id="sendImg" type="button">Send to Panel</button>
      </div>
      <small>Preview zeichnet ins Canvas. "Send" packt als Single-Frame anim.bin und rendert lokal am ESP32.</small>
      <div id="imgInfo" style="margin-top:8px"></div>
    </div>

    <hr>

    <div>
      <div class="section-title">GIF‑Upload (Browser‑Decode)</div>
      <input id="gifFile" type="file" accept="image/gif">

      <div class="row">
        <label for="srcAspectGif">Quelle</label>
        <select id="srcAspectGif">
          <option value="auto" selected>Auto</option>
          <option value="4:3">4:3</option>
          <option value="16:9">16:9</option>
        </select>

        <label for="scaleModeGif">Mapping</label>
        <select id="scaleModeGif">
          <option value="cover" selected>Cover (Crop)</option>
          <option value="contain">Contain (Letterbox)</option>
        </select>
      </div>

      <div class="row" style="margin-top:10px">
        <button id="prepGif" type="button">Prepare & Upload</button>
        <button id="playGif" type="button">Play</button>
        <button id="stopGif" type="button" class="btn-secondary">Stop</button>
      </div>

      <progress id="p" value="0" max="100"></progress>
      <small>GIF nutzt <b>gifuct-js</b> vom Internet (CDN).</small>
      <div id="info"></div>
      <div id="err"></div>
    </div>

    <hr>

    <div>
      <div class="section-title">Animationen</div>
      <div class="row">
        <label for="fxMode">Effekt</label>
        <select id="fxMode">
          <option value="matrix" selected>Matrix</option>
          <option value="fire">Kaminfeuer</option>
          <option value="twinkle">Twinkle</option>
          <option value="plasma">Plasma Palette‑Shift</option>
        </select>
        <button id="fxStart" type="button">Start</button>
        <button id="fxStop" type="button" class="btn-secondary">Stop</button>
      </div>

      <div class="row">
        <label>Frame ms</label>
        <input id="fxFrameMs" type="range" min="20" max="200" value="50">
        <span class="val" id="fxFrameMsVal">50</span>
      </div>

      <div class="row">
        <label>Param A</label>
        <input id="fxP1" type="range" min="0" max="255" value="120">
        <span class="val" id="fxP1Val">120</span>

        <label>Param B</label>
        <input id="fxP2" type="range" min="0" max="255" value="180">
        <span class="val" id="fxP2Val">180</span>
      </div>

      <div class="row">
        <label>Param C</label>
        <input id="fxP3" type="range" min="0" max="255" value="90">
        <span class="val" id="fxP3Val">90</span>

        <label>Param D</label>
        <input id="fxP4" type="range" min="0" max="255" value="22">
        <span class="val" id="fxP4Val">22</span>
      </div>

      <small id="fxParamLegend">Matrix: Dichte/Trail/Farbe.</small>
    </div>
  </div>
</div>

<script>
(() => {
  if (location.protocol === "https:") { location.href = "http://" + location.host + location.pathname; return; }

  const W=64,H=32,DISPLAY_SCALE=12;
  const canvas=document.getElementById('c');
  const ctx=canvas.getContext('2d');
  canvas.width=W; canvas.height=H;
  canvas.style.width = `${W*DISPLAY_SCALE}px`;
  canvas.style.height = `${H*DISPLAY_SCALE}px`;
  canvas.style.backgroundSize = `${DISPLAY_SCALE}px ${DISPLAY_SCALE}px`;

  const host=location.host;
  document.getElementById('host').textContent=host;

  const statusEl=document.getElementById('status');
  const errEl=document.getElementById('err');
  const infoEl=document.getElementById('info');
  const prog=document.getElementById('p');
  const imgInfo=document.getElementById('imgInfo');
  const workflowStatusEl=document.getElementById('workflowStatus');
  const quickSyncBtn=document.getElementById('quickSync');
  const quickPreviewSendBtn=document.getElementById('quickPreviewSend');

  const srcAspectImg=document.getElementById('srcAspectImg');
  const scaleModeImg=document.getElementById('scaleModeImg');
  const srcAspectGif=document.getElementById('srcAspectGif');
  const scaleModeGif=document.getElementById('scaleModeGif');

  const gammaEl=document.getElementById('gamma');
  const boostEl=document.getElementById('boost');
  const gammaVal=document.getElementById('gammaVal');
  const boostVal=document.getElementById('boostVal');
  const brightnessEl=document.getElementById('brightness');
  const brightnessVal=document.getElementById('brightnessVal');
  const displayMode=document.getElementById('displayMode');
  const clockFormat=document.getElementById('clockFormat');
  const weatherToggle=document.getElementById('weatherToggle');
  const clockColor=document.getElementById('clockColor');
  const clockIntensity=document.getElementById('clockIntensity');
  const clockIntensityVal=document.getElementById('clockIntensityVal');
  const stopwatchStart=document.getElementById('stopwatchStart');
  const stopwatchStop=document.getElementById('stopwatchStop');
  const stopwatchReset=document.getElementById('stopwatchReset');
  const stopwatchColor=document.getElementById('stopwatchColor');
  const sleepEnabled=document.getElementById('sleepEnabled');
  const sleepStart=document.getElementById('sleepStart');
  const sleepEnd=document.getElementById('sleepEnd');
  const sleepDim=document.getElementById('sleepDim');
  const sleepDimVal=document.getElementById('sleepDimVal');

  const brushSel=document.getElementById('brush');
  const paletteEl=document.getElementById('palette');
  const colInput=document.getElementById('col');
  const savePixelartBtn=document.getElementById('savePixelart');
  const loadPixelartBtn=document.getElementById('loadPixelart');
  const pixAnimFramePosEl=document.getElementById('pixAnimFramePos');
  const pixAnimPrevBtn=document.getElementById('pixAnimPrev');
  const pixAnimNextBtn=document.getElementById('pixAnimNext');
  const pixAnimAddBtn=document.getElementById('pixAnimAdd');
  const pixAnimDeleteBtn=document.getElementById('pixAnimDelete');
  const pixAnimPlayBtn=document.getElementById('pixAnimPlay');
  const pixAnimStopBtn=document.getElementById('pixAnimStop');
  const pixAnimSpeedEl=document.getElementById('pixAnimSpeed');
  const pixAnimSpeedVal=document.getElementById('pixAnimSpeedVal');
  const fxMode=document.getElementById('fxMode');
  const fxStart=document.getElementById('fxStart');
  const fxStop=document.getElementById('fxStop');
  const fxFrameMs=document.getElementById('fxFrameMs');
  const fxFrameMsVal=document.getElementById('fxFrameMsVal');
  const fxP1=document.getElementById('fxP1');
  const fxP1Val=document.getElementById('fxP1Val');
  const fxP2=document.getElementById('fxP2');
  const fxP2Val=document.getElementById('fxP2Val');
  const fxP3=document.getElementById('fxP3');
  const fxP3Val=document.getElementById('fxP3Val');
  const fxP4=document.getElementById('fxP4');
  const fxP4Val=document.getElementById('fxP4Val');
  const fxParamLegend=document.getElementById('fxParamLegend');

  // ---- WebSocket
  var ws;
  function connect(){
    ws = new WebSocket(`ws://${host}/ws`);
    ws.binaryType = "arraybuffer";
    ws.onopen=()=>{ statusEl.textContent="connected"; statusEl.className="ok"; syncDisplayState(); fetchSleepConfig(); };
    ws.onclose=()=>{ statusEl.textContent="disconnected"; statusEl.className="bad"; setTimeout(connect,800); };
    ws.onerror=()=>{ statusEl.textContent="error"; statusEl.className="bad"; };
  }
  connect();

  function sendJson(obj){
    if(ws && ws.readyState===1) ws.send(JSON.stringify(obj));
  }

  function setWorkflowStatus(label, state){
    workflowStatusEl.textContent = label;
    workflowStatusEl.dataset.state = state || "idle";
  }

  function setWorkflowButtonsDisabled(disabled){
    quickSyncBtn.disabled = disabled;
    quickPreviewSendBtn.disabled = disabled;
  }

  function waitForPanelQueueIdle(timeoutMs = 12000){
    const started = performance.now();
    return new Promise((resolve, reject)=>{
      const check=()=>{
        if(!panelBulkActive && panelWorkQueue.length === 0 && !panelPendingRedraw) return resolve();
        if((performance.now() - started) > timeoutMs) return reject(new Error("Panel queue timeout"));
        requestAnimationFrame(check);
      };
      check();
    });
  }

  window.addEventListener('error', (e)=>{ errEl.textContent = "JS error: " + e.message; });

  const PANEL_CHUNK_SIZE = 128;
  let panelBulkActive = false;
  let panelPendingRedraw = false;
  let panelWorkflowActive = false;
  const panelWorkQueue = [];

  function markPanelDirty(){
    panelPendingRedraw = true;
  }

  function enqueuePanelWork(job){
    panelWorkQueue.push(job);
    runPanelQueue();
  }

  async function runPanelQueue(){
    if(panelBulkActive) return;
    panelBulkActive = true;
    while(panelWorkQueue.length){
      const job = panelWorkQueue.shift();
      try{
        await job();
      }catch(err){
        console.error(err);
        errEl.textContent = "Panel job error: " + (err?.message || String(err));
      }
    }
    panelBulkActive = false;
    if(panelPendingRedraw){
      panelPendingRedraw = false;
      enqueuePanelWork(()=>sendAnimFromPix(infoEl));
    }
  }

  function waitForPanelDrain(){
    if(!ws || ws.readyState!==1) return Promise.resolve();
    if(ws.bufferedAmount < 65536) return Promise.resolve();
    return new Promise((resolve)=>{
      const check=()=>{
        if(!ws || ws.readyState!==1 || ws.bufferedAmount < 65536) return resolve();
        requestAnimationFrame(check);
      };
      check();
    });
  }

  // Preview buffer RGB888 0xRRGGBB
  const pix=new Uint32Array(W*H);
  const pixelAnimState = {
    frames: [new Uint32Array(W*H)],
    index: 0,
    speedMs: parseInt(pixAnimSpeedEl.value,10) || 180,
  };
  const PIXELART_STORAGE_KEY = "hub75.pixelart.v1";
  const DISPLAY_MODE_STORAGE_KEY = "hub75.displaymode.v1";
  function redraw(){
    for(let y=0;y<H;y++){
      for(let x=0;x<W;x++){
        const v=pix[y*W+x];
        const r=(v>>16)&255,g=(v>>8)&255,b=v&255;
        ctx.fillStyle=`rgb(${r},${g},${b})`;
        ctx.fillRect(x,y,1,1);
      }
    }
  }

  function clonePixBuffer(src){
    const out = new Uint32Array(W*H);
    out.set(src);
    return out;
  }

  function setPixFromFrame(frame){
    if(!frame || frame.length !== W*H) return;
    pix.set(frame);
    redraw();
  }

  function syncCurrentPixelAnimFrameFromPix(){
    if(!pixelAnimState.frames.length) pixelAnimState.frames = [new Uint32Array(W*H)];
    pixelAnimState.frames[pixelAnimState.index] = clonePixBuffer(pix);
  }

  function refreshPixelAnimUi(){
    const count = pixelAnimState.frames.length;
    pixAnimFramePosEl.textContent = `${pixelAnimState.index + 1}/${count}`;
    pixAnimPrevBtn.disabled = (count <= 1);
    pixAnimNextBtn.disabled = (count <= 1);
    pixAnimDeleteBtn.disabled = (count <= 1);
    pixAnimSpeedVal.textContent = `${pixelAnimState.speedMs} ms`;
  }

  function switchPixelAnimFrame(nextIndex){
    const count = pixelAnimState.frames.length;
    if(count < 1) return;
    const idx = ((nextIndex % count) + count) % count;
    syncCurrentPixelAnimFrameFromPix();
    pixelAnimState.index = idx;
    setPixFromFrame(pixelAnimState.frames[pixelAnimState.index]);
    refreshPixelAnimUi();
  }

  function resetPixelAnimWithCurrentPix(){
    pixelAnimState.frames = [clonePixBuffer(pix)];
    pixelAnimState.index = 0;
    refreshPixelAnimUi();
  }

  async function sendPixelsFromPix(){
    sendJson({t:"stop"});
    sendJson({t:"clear"});
    for(let i=0;i<W*H;i++){
      const col = pix[i];
      const x = i % W;
      const y = Math.floor(i / W);
      sendJson({t:"px", x, y, c: col});
      if((i+1) % PANEL_CHUNK_SIZE === 0){
        await waitForPanelDrain();
        await new Promise(requestAnimationFrame);
      }
    }
  }

  function redrawPanelFromPix(){
    enqueuePanelWork(()=>sendAnimFromPix(infoEl));
  }

  async function runPanelWorkflow(label, job){
    if(panelWorkflowActive || panelBulkActive || panelWorkQueue.length){
      setWorkflowStatus("Busy", "busy");
      errEl.textContent = "Panel-Workflow läuft bereits. Bitte kurz warten.";
      return;
    }
    panelWorkflowActive = true;
    setWorkflowButtonsDisabled(true);
    errEl.textContent = "";
    setWorkflowStatus(label, "busy");
    try{
      await job();
      await waitForPanelQueueIdle();
      setWorkflowStatus("Done", "done");
      setTimeout(()=>setWorkflowStatus("Idle", "idle"), 1200);
    }catch(err){
      setWorkflowStatus("Error", "error");
      errEl.textContent = "Workflow error: " + (err?.message || String(err));
    } finally {
      panelWorkflowActive = false;
      setWorkflowButtonsDisabled(false);
    }
  }

  function hexToRgb(hex){
    const h=hex.replace("#","");
    return (parseInt(h.slice(0,2),16)<<16)|(parseInt(h.slice(2,4),16)<<8)|parseInt(h.slice(4,6),16);
  }

  // ===== Gamma + Boost LUT (applies to Images + GIF) =====
  let lut = new Uint8Array(256);
  function clamp255(v){ return v<0?0:(v>255?255:v); }

  function rebuildLUT(){
    const gamma = (parseInt(gammaEl.value,10)||120)/100.0;
    const boost = (parseInt(boostEl.value,10)||110)/100.0;
    gammaVal.textContent = gamma.toFixed(2);
    boostVal.textContent = boost.toFixed(2);

    const invG = 1.0 / gamma;
    for(let i=0;i<256;i++){
      const x = i/255.0;
      let y = Math.pow(x, invG) * 255.0;
      y = y * boost;
      lut[i] = clamp255(y+0.5)|0;
    }
  }
  gammaEl.addEventListener('input', rebuildLUT);
  boostEl.addEventListener('input', rebuildLUT);
  rebuildLUT();

  function clamp(v, min, max){ return Math.min(max, Math.max(min, v)); }

  function sendBrightness(){
    const value = clamp(parseInt(brightnessEl.value,10) || 5, 5, 255);
    brightnessVal.textContent = String(value);
    sendJson({t:"bright", v:value});
  }
  brightnessEl.addEventListener('input', sendBrightness);
  sendBrightness();

  const fxState = {
    mode: fxMode.value,
    running: false,
    frameMs: parseInt(fxFrameMs.value,10),
    p1: parseInt(fxP1.value,10),
    p2: parseInt(fxP2.value,10),
    p3: parseInt(fxP3.value,10),
    p4: parseInt(fxP4.value,10),
  };

  function applyFxPreset(){
    const presets = {
      matrix:{p1:120,p2:180,p3:100,p4:0,legend:'Matrix: Dichte / Trail / Grünanteil'},
      fire:{p1:2,p2:150,p3:70,p4:0,legend:'Kaminfeuer: Decay / Sparks / Smoke'},
      twinkle:{p1:90,p2:22,p3:255,p4:0,legend:'Twinkle: Spawn / Fade / Weißanteil'},
      plasma:{p1:7,p2:11,p3:5,p4:2,legend:'Plasma: ax / ay / axy / Palette‑Shift'},
    };
    const p = presets[fxState.mode] || presets.matrix;
    fxP1.value = String(p.p1); fxP2.value = String(p.p2); fxP3.value = String(p.p3); fxP4.value = String(p.p4);
    fxState.p1=p.p1; fxState.p2=p.p2; fxState.p3=p.p3; fxState.p4=p.p4;
    fxParamLegend.textContent = p.legend;
    updateFxDisplay();
  }

  function updateFxDisplay(){
    fxFrameMsVal.textContent = String(fxState.frameMs);
    fxP1Val.textContent = String(fxState.p1);
    fxP2Val.textContent = String(fxState.p2);
    fxP3Val.textContent = String(fxState.p3);
    fxP4Val.textContent = String(fxState.p4);
  }
  applyFxPreset();

  function sendFx(runOverride){
    if (typeof runOverride === "boolean") fxState.running = runOverride;
    if (fxState.running) ensureUiMode();
    sendJson({ t:"fx", mode:fxState.mode, run:fxState.running?1:0, frameMs:fxState.frameMs, p1:fxState.p1, p2:fxState.p2, p3:fxState.p3, p4:fxState.p4 });
  }

  fxMode.addEventListener('change', () => {
    fxState.mode = fxMode.value;
    applyFxPreset();
    if (fxState.running) sendFx(true);
  });
  fxStart.addEventListener('click', () => sendFx(true));
  fxStop.addEventListener('click', () => sendFx(false));

  function bindFxRange(el, key, valEl){
    el.addEventListener('input', () => {
      fxState[key] = parseInt(el.value,10);
      if (valEl) valEl.textContent = String(fxState[key]);
      if (fxState.running) sendFx(true);
    });
  }
  bindFxRange(fxFrameMs, "frameMs", fxFrameMsVal);
  bindFxRange(fxP1, "p1", fxP1Val);
  bindFxRange(fxP2, "p2", fxP2Val);
  bindFxRange(fxP3, "p3", fxP3Val);
  bindFxRange(fxP4, "p4", fxP4Val);

  function applyLUT(v){ return lut[v&255]; }
  function rgb888To565LUT(r,g,b){
    r = applyLUT(r); g = applyLUT(g); b = applyLUT(b);
    return ((r&0xF8)<<8) | ((g&0xFC)<<3) | (b>>3);
  }
  function rgb888To565(r,g,b){
    return ((r&0xF8)<<8) | ((g&0xFC)<<3) | (b>>3);
  }

  const clockState = {
    format: clockFormat.value,
    weather: weatherToggle.value,
    color: hexToRgb(clockColor.value),
    intensity: parseInt(clockIntensity.value,10),
  };

  const stopwatchState = {
    running: false,
    color: hexToRgb(stopwatchColor.value),
  };

  const sleepState = {
    enabled: sleepEnabled.value,
    start: sleepStart.value,
    end: sleepEnd.value,
    dim: parseInt(sleepDim.value,10),
  };

  function pad2(v){ return String(v).padStart(2, "0"); }
  function parseTime(value){
    const parts = value.split(":");
    if (parts.length < 2) return {h:0,m:0};
    const h = Math.min(23, Math.max(0, parseInt(parts[0],10) || 0));
    const m = Math.min(59, Math.max(0, parseInt(parts[1],10) || 0));
    return {h,m};
  }
  function formatTime(h,m){ return `${pad2(h)}:${pad2(m)}`; }

  function syncSleepUi(){
    sleepEnabled.value = sleepState.enabled;
    sleepStart.value = sleepState.start;
    sleepEnd.value = sleepState.end;
    sleepDim.value = String(sleepState.dim);
    sleepDimVal.textContent = `${sleepState.dim}%`;
  }
  syncSleepUi();

  try{
    const savedMode = localStorage.getItem(DISPLAY_MODE_STORAGE_KEY);
    if(savedMode === "ui" || savedMode === "clock" || savedMode === "stopwatch") displayMode.value = savedMode;
  }catch(err){}

  function ensureUiMode(){
    if(displayMode.value === "ui") return;
    displayMode.value = "ui";
    try{ localStorage.setItem(DISPLAY_MODE_STORAGE_KEY, "ui"); }catch(err){}
    sendJson({t:"mode", mode: "ui"});
  }

  function syncDisplayState(){
    sendJson({t:"mode", mode: displayMode.value});
    sendJson({t:"clockfmt", fmt: clockState.format});
    sendJson({t:"weather", on: clockState.weather === "on" ? 1 : 0});
    sendJson({t:"clock", c: clockState.color, i: clockState.intensity});
    sendJson({t:"stopwatch", ring: stopwatchState.color});
  }

  function sendSleepConfig(){
    const start = parseTime(sleepState.start);
    const end = parseTime(sleepState.end);
    const dim = Math.min(20, Math.max(0, sleepState.dim));
    sendJson({
      t:"sleep",
      on: sleepState.enabled === "on" ? 1 : 0,
      sh: start.h,
      sm: start.m,
      eh: end.h,
      em: end.m,
      dim,
    });
  }

  async function fetchSleepConfig(){
    try {
      const res = await fetch("/api/sleep");
      if (!res.ok) return;
      const cfg = await res.json();
      sleepState.enabled = cfg.enabled ? "on" : "off";
      sleepState.start = formatTime(cfg.startHour, cfg.startMinute);
      sleepState.end = formatTime(cfg.endHour, cfg.endMinute);
      sleepState.dim = Math.min(20, Math.max(0, parseInt(cfg.dim,10) || 0));
      syncSleepUi();
    } catch (err) {}
  }

  displayMode.addEventListener('change', () => {
    try{ localStorage.setItem(DISPLAY_MODE_STORAGE_KEY, displayMode.value); }catch(err){}
    sendJson({t:"mode", mode: displayMode.value});
  });

  clockFormat.addEventListener('change', () => {
    clockState.format = clockFormat.value;
    sendJson({t:"clockfmt", fmt: clockState.format});
  });

  weatherToggle.addEventListener('change', () => {
    clockState.weather = weatherToggle.value;
    sendJson({t:"weather", on: clockState.weather === "on" ? 1 : 0});
  });

  clockColor.addEventListener('input', () => {
    clockState.color = hexToRgb(clockColor.value);
    sendJson({t:"clock", c: clockState.color});
  });

  clockIntensity.addEventListener('input', () => {
    clockState.intensity = parseInt(clockIntensity.value,10);
    clockIntensityVal.textContent = String(clockState.intensity);
    sendJson({t:"clock", i: clockState.intensity});
  });

  stopwatchStart.addEventListener('click', () => {
    stopwatchState.running = true;
    sendJson({t:"stopwatch", run: 1});
  });

  stopwatchStop.addEventListener('click', () => {
    stopwatchState.running = false;
    sendJson({t:"stopwatch", run: 0});
  });

  stopwatchReset.addEventListener('click', () => {
    stopwatchState.running = false;
    sendJson({t:"stopwatch", reset: 1});
  });

  stopwatchColor.addEventListener('input', () => {
    stopwatchState.color = hexToRgb(stopwatchColor.value);
    sendJson({t:"stopwatch", ring: stopwatchState.color});
  });

  sleepEnabled.addEventListener('change', () => {
    sleepState.enabled = sleepEnabled.value;
    sendSleepConfig();
  });
  sleepStart.addEventListener('change', () => {
    sleepState.start = sleepStart.value;
    sendSleepConfig();
  });
  sleepEnd.addEventListener('change', () => {
    sleepState.end = sleepEnd.value;
    sendSleepConfig();
  });
  sleepDim.addEventListener('input', () => {
    sleepState.dim = parseInt(sleepDim.value,10);
    sleepDimVal.textContent = `${sleepState.dim}%`;
    sendSleepConfig();
  });

  // ===== Pixel painting with Brush =====
  canvas.addEventListener('contextmenu', e => e.preventDefault());
  let drawing=false;
  let erase=false;

  function evtToXY(e){
    const r=canvas.getBoundingClientRect();
    const scaleX = canvas.width / r.width;
    const scaleY = canvas.height / r.height;
    const x=Math.floor((e.clientX - r.left) * scaleX);
    const y=Math.floor((e.clientY - r.top) * scaleY);
    if(x<0||x>=W||y<0||y>=H) return null;
    return {x,y};
  }

  function paintBrushAt(x,y,col){
    const size = parseInt(brushSel.value,10) || 1;
    const half = Math.floor(size/2);

    for(let yy=0; yy<size; yy++){
      for(let xx=0; xx<size; xx++){
        const px = x + (xx - half);
        const py = y + (yy - half);
        if(px<0||px>=W||py<0||py>=H) continue;

        pix[py*W+px] = col;
        pixelAnimState.frames[pixelAnimState.index][py*W+px] = col;
        const rr=(col>>16)&255, gg=(col>>8)&255, bb=col&255;
        ctx.fillStyle=`rgb(${rr},${gg},${bb})`;
        ctx.fillRect(px,py,1,1);

        if(panelBulkActive){
          markPanelDirty();
        }else{
          sendJson({t:"px", x:px, y:py, c:col});
        }
      }
    }
  }

  function paint(e){
    const p=evtToXY(e);
    if(!p) return;
    const col = erase ? 0x000000 : hexToRgb(colInput.value);
    paintBrushAt(p.x,p.y,col);
  }

  canvas.addEventListener('pointerdown', e=>{
    drawing=true;
    erase = (e.button===2);
    canvas.setPointerCapture(e.pointerId);
    paint(e);
  });
  canvas.addEventListener('pointerup', e=>{
    drawing=false;
    erase=false;
    canvas.releasePointerCapture(e.pointerId);
  });
  canvas.addEventListener('pointercancel', ()=>{ drawing=false; erase=false; });
  canvas.addEventListener('pointermove', e=>{ if(drawing) paint(e); });

  const paletteColors = [
    "#000000","#ffffff","#ff0000","#00ff00","#0000ff",
    "#ffff00","#ff00ff","#00ffff","#ff8800","#8b4513",
    "#808080","#c0c0c0","#7cfc00","#ff1493","#1e90ff"
  ];
  function setActiveSwatch(hex){
    colInput.value = hex;
    const swatches = paletteEl.querySelectorAll('.swatch');
    swatches.forEach((s)=>{ s.classList.toggle('selected', s.dataset.color === hex); });
  }
  paletteColors.forEach((hex)=>{
    const sw=document.createElement('button');
    sw.type="button";
    sw.className="swatch";
    sw.style.backgroundColor = hex;
    sw.dataset.color = hex;
    sw.addEventListener('click', ()=> setActiveSwatch(hex));
    paletteEl.appendChild(sw);
  });
  colInput.addEventListener('input', () => setActiveSwatch(colInput.value));
  setActiveSwatch(colInput.value);

  document.getElementById('clear').onclick=()=>{
    pix.fill(0); redraw();
    syncCurrentPixelAnimFrameFromPix();
    enqueuePanelWork(async()=>{ sendJson({t:"clear"}); });
  };

  document.getElementById('fill').onclick=()=>{
    const c=hexToRgb(colInput.value);
    pix.fill(c); redraw();
    syncCurrentPixelAnimFrameFromPix();
    enqueuePanelWork(async()=>{ sendJson({t:"fill", c}); });
  };

  document.getElementById('reinit').onclick=async()=>{
    await fetch('/api/reinit');
    pix.fill(0);
    redraw();
    resetPixelAnimWithCurrentPix();
    enqueuePanelWork(async()=>{ sendJson({t:"clear"}); });
  };

  document.getElementById('redrawPanel').onclick=()=>{
    runPanelWorkflow("Sync", async()=>{
      redrawPanelFromPix();
    });
  };

  quickSyncBtn.onclick=()=>{
    runPanelWorkflow("Quick Sync", async()=>{
      redrawPanelFromPix();
    });
  };

  quickPreviewSendBtn.onclick=()=>{
    runPanelWorkflow("Image", async()=>{
      if(!imgEl) throw new Error("Bitte zuerst ein Bild wählen.");
      const mappedData = lastImageFrame || buildImageFrame();
      applyImageDataToPix(mappedData, true);
    });
  };

  function savePixelartToDevice(payload){
    try{
      localStorage.setItem("hub75.pixelart.device", JSON.stringify(payload));
    }catch(err){
      throw err;
    }
  }

  function loadPixelartFromDevice(){
    try{
      const raw = localStorage.getItem("hub75.pixelart.device");
      if (!raw) return null;
      return JSON.parse(raw);
    }catch(err){
      return null;
    }
  }

  function parsePixelartPayload(parsed){
    const loadedSpeed = (parsed && parsed.animSpeedMs != null) ? parsed.animSpeedMs : pixelAnimState.speedMs;
    pixelAnimState.speedMs = clamp(loadedSpeed, 30, 1000);
    pixAnimSpeedEl.value = String(pixelAnimState.speedMs);

    let frames = null;
    if(parsed && Array.isArray(parsed.frames) && parsed.frames.length){
      frames = [];
      for(const frame of parsed.frames){
        if(!Array.isArray(frame) || frame.length !== W*H) continue;
        const buf = new Uint32Array(W*H);
        for(let i=0;i<W*H;i++) buf[i] = frame[i] >>> 0;
        frames.push(buf);
      }
      if(!frames.length) frames = null;
    }

    let data = null;
    if(Array.isArray(parsed)){
      data = parsed;
    }else if(parsed && Array.isArray(parsed.data)){
      if(parsed.w !== W || parsed.h !== H){
        errEl.textContent = "Gespeicherte Pixelart hat falsches Format.";
        return null;
      }
      data = parsed.data;
    }
    if(!Array.isArray(data) || data.length !== W*H){
      errEl.textContent = "Gespeicherte Pixelart ist inkompatibel.";
      return null;
    }
    for(let i=0;i<W*H;i++){ pix[i] = data[i] >>> 0; }
    if(frames){
      pixelAnimState.frames = frames;
    } else {
      pixelAnimState.frames = [clonePixBuffer(pix)];
    }
    pixelAnimState.index = 0;
    setPixFromFrame(pixelAnimState.frames[0]);
    refreshPixelAnimUi();
    redraw();
    return data;
  }

  async function savePixelart(){
    try{
      const payload = {
        v: 1,
        w: W,
        h: H,
        data: Array.from(pix),
        frames: pixelAnimState.frames.map((frame)=>Array.from(frame)),
        animSpeedMs: pixelAnimState.speedMs,
        savedAt: Date.now(),
      };
      localStorage.setItem(PIXELART_STORAGE_KEY, JSON.stringify(payload));
      savePixelartToDevice(payload);
      infoEl.textContent = "Pixelart gespeichert (Browser).";
    }catch(err){
      errEl.textContent = "Save fehlgeschlagen: " + (err?.message || String(err));
    }
  }

  async function loadPixelart(){
    try{
      const remote = loadPixelartFromDevice();
      if (remote) {
        const ok = parsePixelartPayload(remote);
        if(ok){
          infoEl.textContent = "Pixelart geladen (lokal).";
          return;
        }
      }
      const raw = localStorage.getItem(PIXELART_STORAGE_KEY);
      if(!raw){
        errEl.textContent = "Kein Pixelart-Slot gefunden.";
        return;
      }
      const parsed = JSON.parse(raw);
      const ok = parsePixelartPayload(parsed);
      if(ok) infoEl.textContent = "Pixelart geladen (Browser).";
    }catch(err){
      errEl.textContent = "Load fehlgeschlagen: " + (err?.message || String(err));
    }
  }

  savePixelartBtn.onclick=()=> savePixelart();
  loadPixelartBtn.onclick=()=> loadPixelart();

  pixAnimPrevBtn.onclick=()=> switchPixelAnimFrame(pixelAnimState.index - 1);
  pixAnimNextBtn.onclick=()=> switchPixelAnimFrame(pixelAnimState.index + 1);
  pixAnimAddBtn.onclick=()=>{
    syncCurrentPixelAnimFrameFromPix();
    const template = pixelAnimState.frames[pixelAnimState.index];
    const nextFrame = clonePixBuffer(template);
    pixelAnimState.frames.splice(pixelAnimState.index + 1, 0, nextFrame);
    pixelAnimState.index++;
    setPixFromFrame(nextFrame);
    refreshPixelAnimUi();
    infoEl.textContent = `Frame ${pixelAnimState.index + 1} hinzugefügt.`;
  };
  pixAnimDeleteBtn.onclick=()=>{
    if(pixelAnimState.frames.length <= 1) return;
    pixelAnimState.frames.splice(pixelAnimState.index, 1);
    if(pixelAnimState.index >= pixelAnimState.frames.length){
      pixelAnimState.index = pixelAnimState.frames.length - 1;
    }
    setPixFromFrame(pixelAnimState.frames[pixelAnimState.index]);
    refreshPixelAnimUi();
    infoEl.textContent = "Frame gelöscht.";
  };
  pixAnimSpeedEl.addEventListener('input', ()=>{
    pixelAnimState.speedMs = clamp(parseInt(pixAnimSpeedEl.value,10) || 180, 30, 1000);
    refreshPixelAnimUi();
  });
  refreshPixelAnimUi();

  // ===== Aspect/Scale mapping =====
  function desiredAspectValue(sel) {
    const v = sel.value;
    if (v === "4:3") return 4/3;
    if (v === "16:9") return 16/9;
    return null;
  }

  const oc=document.createElement('canvas'); oc.width=W; oc.height=H;
  const octx=oc.getContext('2d',{willReadFrequently:true});

  function mapImageTo64x32(sourceCanvasOrImg, srcW, srcH, srcAspectSel, scaleModeSel){
    const sc=document.createElement('canvas'); sc.width=srcW; sc.height=srcH;
    const sctx=sc.getContext('2d',{willReadFrequently:true});
    sctx.clearRect(0,0,srcW,srcH);
    sctx.drawImage(sourceCanvasOrImg, 0, 0);

    const forced = desiredAspectValue(srcAspectSel);
    let cropX=0, cropY=0, cropW=srcW, cropH=srcH;

    if (forced) {
      const srcAspect = srcW / srcH;
      if (srcAspect > forced) {
        cropH = srcH;
        cropW = Math.round(srcH * forced);
        cropX = Math.round((srcW - cropW) / 2);
      } else {
        cropW = srcW;
        cropH = Math.round(srcW / forced);
        cropY = Math.round((srcH - cropH) / 2);
      }
    }

    const mode = scaleModeSel.value;
    octx.clearRect(0,0,W,H);

    if (mode === "cover") {
      const s = Math.max(W / cropW, H / cropH);
      const dw = cropW * s;
      const dh = cropH * s;
      const dx = (W - dw) / 2;
      const dy = (H - dh) / 2;
      octx.drawImage(sc, cropX, cropY, cropW, cropH, dx, dy, dw, dh);
    } else {
      const s = Math.min(W / cropW, H / cropH);
      const dw = cropW * s;
      const dh = cropH * s;
      const dx = (W - dw) / 2;
      const dy = (H - dh) / 2;
      octx.fillStyle = "black";
      octx.fillRect(0,0,W,H);
      octx.drawImage(sc, cropX, cropY, cropW, cropH, dx, dy, dw, dh);
    }

    return octx.getImageData(0,0,W,H);
  }

  function buildFramePayload(source){
    const rgba = source && source.data ? source.data : source;
    if(!rgba || rgba.length < W*H*4) return null;
    const out = new Uint8Array(1 + W*H*2);
    out[0] = 0x46; // 'F'
    let o=1;

    for(let i=0;i<W*H;i++){
      const k=i*4;
      const a = rgba[k+3];
      const r = applyLUT(a ? rgba[k] : 0);
      const g = applyLUT(a ? rgba[k+1] : 0);
      const b = applyLUT(a ? rgba[k+2] : 0);

      pix[i] = (r<<16)|(g<<8)|b;

      const c565 = ((r&0xF8)<<8) | ((g&0xFC)<<3) | (b>>3);
      out[o++] = c565 & 255;
      out[o++] = (c565 >> 8) & 255;
    }
    redraw();
    return out;
  }

  function sendFrameBinary(frame){
    if(!ws || ws.readyState!==1) { alert("WebSocket not connected"); return; }
    sendJson({t:"stop"});
    const payload = frame instanceof Uint8Array ? frame : new Uint8Array(frame);
    ws.send(payload);
  }

  // ===== Image workflow =====
  let imgObjUrl = null;
  let imgEl = null;
  let lastImageFrame = null;

  document.getElementById('imgFile').addEventListener('change', async ()=>{
    const f=document.getElementById('imgFile').files?.[0];
    if(!f) return;
    if(imgObjUrl) URL.revokeObjectURL(imgObjUrl);
    imgObjUrl = URL.createObjectURL(f);

    imgEl = new Image();
    imgEl.onload = () => {
      imgInfo.textContent = `Loaded: ${f.name} (${imgEl.width}×${imgEl.height})`;
      lastImageFrame = null;
    };
    imgEl.src = imgObjUrl;
  });

  function applyImageDataToPix(imgData, shouldSend){
    if(!imgData || !imgData.data) return;
    const rgba = imgData.data;
    for(let i=0;i<W*H;i++){
      const k=i*4;
      const a = rgba[k+3];
      const r = applyLUT(a ? rgba[k] : 0);
      const g = applyLUT(a ? rgba[k+1] : 0);
      const b = applyLUT(a ? rgba[k+2] : 0);
      const col = (r<<16)|(g<<8)|b;
      pix[i] = col;
    }
    redraw();
    if(shouldSend){
      enqueuePanelWork(()=>sendAnimFromPix(imgInfo));
    }
  }

  function buildImageFrame(){
    if(!imgEl) return null;
    const iw = imgEl.naturalWidth || imgEl.width;
    const ih = imgEl.naturalHeight || imgEl.height;
    if(!iw || !ih) return null;

    const tmp=document.createElement('canvas');
    tmp.width=iw; tmp.height=ih;
    const tctx=tmp.getContext('2d',{willReadFrequently:true});
    tctx.drawImage(imgEl, 0, 0, iw, ih);

    const mappedData = mapImageTo64x32(tmp, iw, ih, srcAspectImg, scaleModeImg);
    applyImageDataToPix(mappedData, false);
    lastImageFrame = mappedData;
    return mappedData;
  }

  document.getElementById('previewImg').onclick = async ()=>{
    if(!imgEl) return alert("Choose an image first.");
    setWorkflowStatus("Preview", "busy");
    buildImageFrame();
    setWorkflowStatus("Idle", "idle");
  };

  document.getElementById('sendImg').onclick = async ()=>{
    if(!imgEl) return alert("Choose an image first.");
    setWorkflowStatus("Send", "busy");
    const mappedData = lastImageFrame || buildImageFrame();
    applyImageDataToPix(mappedData, true);
    setWorkflowStatus("Idle", "idle");
  };

  // ===== GIF: build anim.bin (RLE RGB565) =====
  function u16le(n){ return new Uint8Array([n&255,(n>>8)&255]); }
  function u32le(n){ return new Uint8Array([n&255,(n>>8)&255,(n>>16)&255,(n>>24)&255]); }

  function rleEncode565(rgb565){
    const out=[];
    let i=0;
    while(i<rgb565.length){
      const c=rgb565[i];
      let cnt=1;
      while(i+cnt<rgb565.length && rgb565[i+cnt]===c && cnt<65535) cnt++;
      out.push(u16le(cnt), u16le(c));
      i+=cnt;
    }
    let total=0; for(const a of out) total+=a.length;
    const buf=new Uint8Array(total);
    let o=0; for(const a of out){ buf.set(a,o); o+=a.length; }
    return buf;
  }

  function frameRGB565ToRecord(rgb565, delayMs){
    const rle=rleEncode565(rgb565);
    const parts=[u16le(delayMs), u32le(rle.length), rle];
    let total=0; for(const p of parts) total+=p.length;
    const out=new Uint8Array(total);
    let o=0; for(const p of parts){ out.set(p,o); o+=p.length; }
    return out;
  }

  function frameRGBAtoRecord(rgba, delayMs){
    const rgb565=new Uint16Array(W*H);
    for(let i=0;i<W*H;i++){
      const k=i*4;
      rgb565[i]=rgb888To565LUT(rgba[k], rgba[k+1], rgba[k+2]);
    }
    return frameRGB565ToRecord(rgb565, delayMs);
  }

  function buildAnimBinFromFrames(frameRecords, loopFlag){
    const header=new Uint8Array(16);
    header[0]=0x41; header[1]=0x36; header[2]=0x34; header[3]=0x78; // "A64x"
    header[4]=W; header[5]=H;
    const frameCount = frameRecords.length;
    header[6]=frameCount&255; header[7]=(frameCount>>8)&255;
    header[8]=loopFlag ? 1 : 0;
    const parts=[header, ...frameRecords];
    let total=0; for(const p of parts) total+=p.length;
    const out=new Uint8Array(total);
    let o=0; for(const p of parts){ out.set(p,o); o+=p.length; }
    return out;
  }

  function buildAnimBinFromPix(pixBuf, delayMs, loopFlag){
    const rgb565=new Uint16Array(W*H);
    for(let i=0;i<W*H;i++){
      const col = pixBuf[i];
      const r=(col>>16)&255, g=(col>>8)&255, b=col&255;
      rgb565[i]=rgb888To565(r,g,b);
    }
    const record = frameRGB565ToRecord(rgb565, delayMs);
    return buildAnimBinFromFrames([record], loopFlag);
  }

  function framePixToRecord(pixBuf, delayMs){
    const rgb565=new Uint16Array(W*H);
    for(let i=0;i<W*H;i++){
      const col = pixBuf[i];
      const r=(col>>16)&255, g=(col>>8)&255, b=col&255;
      rgb565[i]=rgb888To565(r,g,b);
    }
    return frameRGB565ToRecord(rgb565, delayMs);
  }

  async function uploadAnimBin(bin){
    const fd=new FormData();
    fd.append('anim', new Blob([bin],{type:'application/octet-stream'}), 'anim.bin');
    const res=await fetch('/uploadAnim',{method:'POST', body: fd});
    if(!res.ok) throw new Error("Upload failed");
    return res.text();
  }

  async function sendAnimFromPix(statusTarget){
    ensureUiMode();
    const bin = buildAnimBinFromPix(pix, 100, false);
    const resp = await uploadAnimBin(bin);
    if(statusTarget) statusTarget.textContent = resp || "anim uploaded";
    await fetch('/api/anim/play');
  }

  async function sendPixelartFramesLoop(statusTarget){
    ensureUiMode();
    syncCurrentPixelAnimFrameFromPix();
    const records = pixelAnimState.frames.map((frame)=>framePixToRecord(frame, pixelAnimState.speedMs));
    const bin = buildAnimBinFromFrames(records, true);
    const resp = await uploadAnimBin(bin);
    if(statusTarget) statusTarget.textContent = resp || "pixelart loop uploaded";
    await fetch('/api/anim/play');
  }

  pixAnimPlayBtn.onclick=()=>{
    runPanelWorkflow("Pixelart Loop", async()=>{
      await sendPixelartFramesLoop(infoEl);
    });
  };
  pixAnimStopBtn.onclick=async()=>{ await fetch('/api/anim/stop'); };

  // gifuct-js CDN -> window.GIF
  async function loadGifuct(){
    if(window.GIF) return;
    await new Promise((resolve,reject)=>{
      const s=document.createElement('script');
      s.src="https://cdn.jsdelivr.net/npm/gifuct-js@1.0.0/dist/gifuct-js.min.js";
      s.onload=resolve;
      s.onerror=()=>reject(new Error("Could not load gifuct-js (no internet?)"));
      document.head.appendChild(s);
    });
    if(!window.GIF) throw new Error("gifuct-js loaded, but window.GIF is missing");
  }

  let gifBuf=null;
  document.getElementById('gifFile').addEventListener('change', async ()=>{
    const f=document.getElementById('gifFile').files?.[0];
    if(!f) return;
    gifBuf=await f.arrayBuffer();
    infoEl.textContent=`Selected: ${f.name} (${Math.round(f.size/1024)} KB)`;
    errEl.textContent="";
  });

  document.getElementById('playGif').onclick=async()=>{ ensureUiMode(); await fetch('/api/anim/play'); };
  document.getElementById('stopGif').onclick=async()=>{ await fetch('/api/anim/stop'); };

  document.getElementById('prepGif').onclick=async()=>{
    try{
      if(!gifBuf) return alert("Choose a GIF first.");
      prog.value=0;
      infoEl.textContent="Loading GIF decoder…";
      await loadGifuct();

      const gif = new window.GIF(gifBuf);
      const frames = gif.decompressFrames(true);

      const rawFrameCount=frames.length;
      const frameCount=Math.min(rawFrameCount, 50);
      if(rawFrameCount > frameCount){
        infoEl.innerHTML=`Decoded frames: <b>${rawFrameCount}</b> → limitiert auf <b>${frameCount}</b>`;
      }else{
        infoEl.innerHTML=`Decoded frames: <b>${frameCount}</b>`;
      }
      prog.value=5;

      const chunks=[];

      for(let i=0;i<frameCount;i++){
        const fr=frames[i];
        const delayMs=Math.max(20, Math.min(1000, (fr.delay||10)*10));
        const imgData=new ImageData(new Uint8ClampedArray(fr.patch), fr.dims.width, fr.dims.height);

        const tmp=document.createElement('canvas');
        tmp.width=fr.dims.width; tmp.height=fr.dims.height;
        const tctx=tmp.getContext('2d',{willReadFrequently:true});
        tctx.putImageData(imgData,0,0);

        const mappedData = mapImageTo64x32(tmp, tmp.width, tmp.height, srcAspectGif, scaleModeGif);
        const rgba64 = mappedData.data;

        if(i===frameCount-1){ buildFramePayload(mappedData); }

        chunks.push(frameRGBAtoRecord(rgba64, delayMs));
        prog.value=Math.round(5 + ((i+1)/frameCount)*85);
      }

      const bin = buildAnimBinFromFrames(chunks, true);

      infoEl.innerHTML+=`<br/>Prepared size: <b>${Math.round(bin.length/1024)} KB</b> — uploading…`;
      const resp=await uploadAnimBin(bin);
      prog.value=100;
      infoEl.innerHTML+=`<br/><b>Upload OK</b> (${resp})`;
    }catch(e){
      errEl.textContent = (e && e.message) ? e.message : String(e);
      prog.value=0;
    }
  };

  // invalidate cached image frame when tuning changes
  function invalidateCaches(){ lastImageFrame = null; }
  gammaEl.addEventListener('input', invalidateCaches);
  boostEl.addEventListener('input', invalidateCaches);
  srcAspectImg.addEventListener('change', invalidateCaches);
  scaleModeImg.addEventListener('change', invalidateCaches);

  pix.fill(0); redraw();
})();
</script>
</body></html>
)HTML";

// =====================
// Helpers
// =====================
static inline uint16_t rgb888_to_565(uint32_t rrggbb) {
  uint8_t r = (rrggbb >> 16) & 0xFF;
  uint8_t g = (rrggbb >> 8) & 0xFF;
  uint8_t b = rrggbb & 0xFF;
  return ((r & 0xF8) << 8) | ((g & 0xFC) << 3) | (b >> 3);
}

static inline uint16_t scale565(uint16_t c, uint8_t factor) {
  uint8_t r = (c >> 11) & 0x1F;
  uint8_t g = (c >> 5) & 0x3F;
  uint8_t b = c & 0x1F;
  r = (uint16_t)r * factor >> 8;
  g = (uint16_t)g * factor >> 8;
  b = (uint16_t)b * factor >> 8;
  return (r << 11) | (g << 5) | b;
}

static inline uint16_t blend565(uint16_t a, uint16_t b, uint8_t t) {
  uint8_t ar = (a >> 11) & 0x1F;
  uint8_t ag = (a >> 5) & 0x3F;
  uint8_t ab = a & 0x1F;
  uint8_t br = (b >> 11) & 0x1F;
  uint8_t bg = (b >> 5) & 0x3F;
  uint8_t bb = b & 0x1F;
  uint8_t r = (uint16_t)ar + (((int16_t)br - ar) * t >> 8);
  uint8_t g = (uint16_t)ag + (((int16_t)bg - ag) * t >> 8);
  uint8_t bch = (uint16_t)ab + (((int16_t)bb - ab) * t >> 8);
  return (r << 11) | (g << 5) | bch;
}

static uint16_t hsv_to_565(uint16_t h, uint8_t s, uint8_t v) {
  h %= 360;
  uint8_t region = h / 60;
  uint8_t remainder = (h % 60) * 255 / 60;
  uint8_t p = (uint16_t)v * (255 - s) >> 8;
  uint8_t q = (uint16_t)v * (255 - ((uint16_t)s * remainder >> 8)) >> 8;
  uint8_t t = (uint16_t)v * (255 - ((uint16_t)s * (255 - remainder) >> 8)) >> 8;
  uint8_t r, g, b;
  switch(region) {
    case 0: r = v; g = t; b = p; break;
    case 1: r = q; g = v; b = p; break;
    case 2: r = p; g = v; b = t; break;
    case 3: r = p; g = q; b = v; break;
    case 4: r = t; g = p; b = v; break;
    default: r = v; g = p; b = q; break;
  }
  return rgb888_to_565((r << 16) | (g << 8) | b);
}

static void draw_full_frame() {
  for (int y=0; y<PANEL_RES_Y; y++)
    for (int x=0; x<PANEL_RES_X; x++)
      dma_display->drawPixel(x, y, fb[y*PANEL_RES_X + x]);
}

static void render_centered_text(const char* text, uint16_t color) {
  if (!dma_display || !text) return;
  dma_display->clearScreen();
  const int len = strlen(text);
  const int textWidth = len * 6;
  const int textHeight = 8;
  int x = (PANEL_RES_X - textWidth) / 2;
  int y = (PANEL_RES_Y - textHeight) / 2;
  if (x < 0) x = 0;
  if (y < 0) y = 0;
  dma_display->setTextSize(1);
  dma_display->setTextWrap(false);
  for (int i = 0; i < len; i++) {
    dma_display->drawChar(x + i * 6, y, text[i], color, 0, 1);
  }
}

static void render_fixed_text(const char* text, uint16_t color, int y) {
  if (!dma_display || !text) return;
  int len = strlen(text);
  int textWidth = len * 6;
  int x = (PANEL_RES_X - textWidth) / 2;
  if (x < 0) x = 0;
  dma_display->setTextWrap(false);
  for (int i = 0; i < len; i++) {
    dma_display->drawChar(x + i * 6, y, text[i], color, 0, 1);
  }
}

static void draw_clock_char_4x7(int x, int y, char c, uint16_t color) {
  if (!dma_display) return;
  if (c >= '0' && c <= '9') {
    const uint8_t* glyph = CLOCK_DIGITS_4X7[c - '0'];
    for (int row = 0; row < 7; row++) {
      uint8_t bits = glyph[row];
      for (int col = 0; col < 4; col++) {
        if (bits & (1 << (3 - col))) {
          dma_display->drawPixel(x + col, y + row, color);
        }
      }
    }
    return;
  }

  if (c == ':') {
    // Fester Doppelpunkt: obere/untere 2x2-Punkte exakt übereinander.
    for (int dy = 0; dy < 2; dy++) {
      for (int dx = 0; dx < 2; dx++) {
        dma_display->drawPixel(x + 1 + dx, y + 1 + dy, color);
        dma_display->drawPixel(x + 1 + dx, y + 4 + dy, color);
      }
    }
    return;
  }

  if (c == '-') {
    for (int col = 0; col < 4; col++) dma_display->drawPixel(x + col, y + 3, color);
    return;
  }
}

static void render_clock_pattern(const char* text, uint16_t color, int y) {
  if (!dma_display || !text) return;
  const int slotWidth = 6;   // 4px Glyph + 2px Abstand
  const int len = strlen(text);
  const int totalWidth = len * slotWidth;
  int x = (PANEL_RES_X - totalWidth) / 2;
  if (x < 0) x = 0;
  for (int i = 0; i < len; i++) {
    draw_clock_char_4x7(x + i * slotWidth, y, text[i], color);
  }
}

static void draw_icon16(const uint16_t *rows, uint16_t color, int x, int y) {
  if (!dma_display || !rows) return;
  for (int ry = 0; ry < 16; ry++) {
    uint16_t row = rows[ry];
    for (int rx = 0; rx < 16; rx++) {
      if (row & (1 << (15 - rx))) {
        dma_display->drawPixel(x + rx, y + ry, color);
      }
    }
  }
}

static void draw_weather_icon(int16_t code, int x, int y) {
  static const uint16_t ICON_SUN[16] = {
    0b0000011111100000,
    0b0000111111110000,
    0b0001111111111000,
    0b0011111111111100,
    0b0011111111111100,
    0b0111111111111110,
    0b0111111111111110,
    0b1111111111111111,
    0b1111111111111111,
    0b0111111111111110,
    0b0111111111111110,
    0b0011111111111100,
    0b0011111111111100,
    0b0001111111111000,
    0b0000111111110000,
    0b0000011111100000
  };
  static const uint16_t ICON_CLOUD[16] = {
    0b0000000000000000,
    0b0000000000000000,
    0b0000011111000000,
    0b0001111111110000,
    0b0011111111111000,
    0b0111111111111100,
    0b0111111111111100,
    0b1111111111111110,
    0b1111111111111110,
    0b1111111111111110,
    0b1111111111111110,
    0b1111111111111110,
    0b0111111111111100,
    0b0011111111111000,
    0b0001111111110000,
    0b0000011111000000
  };
  static const uint16_t ICON_RAIN[16] = {
    0b0000000000000000,
    0b0000000000000000,
    0b0000001000100000,
    0b0000010001000000,
    0b0000100010000000,
    0b0001000100000000,
    0b0000001000100000,
    0b0000010001000000,
    0b0000100010000000,
    0b0001000100000000,
    0b0000001000100000,
    0b0000010001000000,
    0b0000100010000000,
    0b0001000100000000,
    0b0000000000000000,
    0b0000000000000000
  };
  static const uint16_t ICON_SNOW[16] = {
    0b0000000000000000,
    0b0000100010000000,
    0b0000010101000000,
    0b0001001110010000,
    0b0000111011100000,
    0b0001001110010000,
    0b0000010101000000,
    0b0000100010000000,
    0b0000100010000000,
    0b0000010101000000,
    0b0001001110010000,
    0b0000111011100000,
    0b0001001110010000,
    0b0000010101000000,
    0b0000100010000000,
    0b0000000000000000
  };
  static const uint16_t ICON_FOG[16] = {
    0b0000000000000000,
    0b0000000000000000,
    0b0011111111111100,
    0b0011111111111100,
    0b0000000000000000,
    0b0111111111111110,
    0b0111111111111110,
    0b0000000000000000,
    0b0011111111111100,
    0b0011111111111100,
    0b0000000000000000,
    0b0111111111111110,
    0b0111111111111110,
    0b0000000000000000,
    0b0000000000000000,
    0b0000000000000000
  };
  static const uint16_t ICON_STORM[16] = {
    0b0000000000000000,
    0b0000011111100000,
    0b0001111111111000,
    0b0011111111111100,
    0b0111111111111110,
    0b0111111111111110,
    0b1111111111111111,
    0b1111111111111111,
    0b0000011100000000,
    0b0000111100000000,
    0b0001110000000000,
    0b0001111000000000,
    0b0000111000000000,
    0b0000000000000000,
    0b0000000000000000,
    0b0000000000000000
  };

  if (!dma_display) return;
  uint16_t sunColor = dma_display->color565(255, 210, 80);
  uint16_t cloudColor = dma_display->color565(160, 190, 220);
  uint16_t rainColor = dma_display->color565(80, 160, 255);
  uint16_t snowColor = dma_display->color565(200, 230, 255);
  uint16_t fogColor = dma_display->color565(140, 170, 200);
  uint16_t stormColor = dma_display->color565(200, 200, 220);

  if (code < 0) {
    draw_icon16(ICON_CLOUD, fogColor, x, y);
    return;
  }

  if (code == 0) {
    draw_icon16(ICON_SUN, sunColor, x, y);
    return;
  }

  if (code == 1 || code == 2) {
    draw_icon16(ICON_SUN, sunColor, x, y);
    draw_icon16(ICON_CLOUD, cloudColor, x + 2, y + 4);
    return;
  }

  if (code == 45 || code == 48) {
    draw_icon16(ICON_FOG, fogColor, x, y);
    return;
  }

  bool rain = (code >= 51 && code <= 57) || (code >= 61 && code <= 67) || (code >= 80 && code <= 82);
  bool snow = (code >= 71 && code <= 77);
  if (code == 3 || rain || snow) {
    draw_icon16(ICON_CLOUD, cloudColor, x, y);
    if (rain) draw_icon16(ICON_RAIN, rainColor, x, y);
    if (snow) draw_icon16(ICON_SNOW, snowColor, x, y);
    return;
  }

  if (code >= 95) {
    draw_icon16(ICON_STORM, stormColor, x, y);
    return;
  }
}

static void render_clock_frame() {
  struct tm timeinfo;
  bool timeOk = getLocalTime(&timeinfo, 0);
  const char* fallback = clockShowSeconds ? "--:--:--" : "--:--";
  char buf[12];
  if (timeOk) {
    if (clockShowSeconds) {
      snprintf(buf, sizeof(buf), "%02d:%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min, timeinfo.tm_sec);
    } else {
      snprintf(buf, sizeof(buf), "%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min);
    }
  } else {
    strncpy(buf, fallback, sizeof(buf));
    buf[sizeof(buf)-1] = '\0';
  }

  uint16_t clockColor565 = scale565(rgb888_to_565(clockColor), clockIntensity);
  uint16_t timeColor = timeOk ? clockColor565 : dma_display->color565(80, 80, 80);
  if (!weatherEnabled) {
    dma_display->clearScreen();
    render_clock_pattern(buf, timeColor, (PANEL_RES_Y - 7) / 2);
    return;
  }

  dma_display->clearScreen();
  dma_display->setTextSize(1);
  dma_display->setTextColor(timeColor);
  int topHalfHeight = PANEL_RES_Y / 2;
  int timeY = (topHalfHeight - 8) / 2;
  if (timeY < 0) timeY = 0;
  render_clock_pattern(buf, timeColor, timeY);

  if (weatherValid) {
    int tempRounded = (int)lroundf(weatherTempC);
    char tempBuf[8];
    snprintf(tempBuf, sizeof(tempBuf), "%dC", tempRounded);
    dma_display->setTextColor(dma_display->color565(140, 200, 255));
    int tempWidth = strlen(tempBuf) * 6;
    int bottomHalfY = PANEL_RES_Y / 2;
    int iconX = (PANEL_RES_X / 2 - 16) / 2;
    int iconY = bottomHalfY;
    if (iconX < 0) iconX = 0;
    draw_weather_icon(weatherCode, iconX, iconY);
    int tempX = (PANEL_RES_X / 2) + ((PANEL_RES_X / 2 - tempWidth) / 2);
    int tempY = bottomHalfY + (topHalfHeight - 8) / 2;
    dma_display->setCursor(tempX, tempY);
    dma_display->print(tempBuf);
  } else {
    dma_display->setTextColor(dma_display->color565(100, 100, 100));
    dma_display->setCursor(2, PANEL_RES_Y - 9);
    dma_display->print("Wetter...");
  }
}

static void perimeter_position(uint32_t pos, int &x, int &y) {
  const uint16_t w = PANEL_RES_X;
  const uint16_t h = PANEL_RES_Y;
  const uint16_t topLen = w;
  const uint16_t rightLen = h - 1;
  const uint16_t bottomLen = w - 1;
  if (pos < topLen) {
    x = pos;
    y = 0;
  } else if (pos < topLen + rightLen) {
    x = w - 1;
    y = (pos - topLen) + 1;
  } else if (pos < topLen + rightLen + bottomLen) {
    x = (w - 1) - (pos - (topLen + rightLen));
    y = h - 1;
  } else {
    x = 0;
    y = (h - 1) - (pos - (topLen + rightLen + bottomLen));
  }
}

static void draw_stopwatch_ring(uint32_t elapsedMs) {
  const uint16_t perimeter = (2 * (PANEL_RES_X + PANEL_RES_Y)) - 4;
  if (perimeter == 0) return;
  const uint32_t minuteMs = 60000;
  uint32_t cycleMs = elapsedMs % minuteMs;
  if (cycleMs == 0 && elapsedMs > 0) {
    for (uint32_t p = 0; p < perimeter; p++) {
      int x = 0;
      int y = 0;
      perimeter_position(p, x, y);
      dma_display->drawPixel(x, y, stopwatchRingColor);
    }
    return;
  }
  uint32_t pos = cycleMs * perimeter / minuteMs;
  for (uint8_t i = 0; i < stopwatchRingLength; i++) {
    uint32_t p = (pos + perimeter - i) % perimeter;
    int x = 0;
    int y = 0;
    perimeter_position(p, x, y);
    dma_display->drawPixel(x, y, stopwatchRingColor);
  }
}

static void render_stopwatch_frame() {
  const uint32_t elapsed = stopwatchRunning ? (millis() - stopwatchStartMs) : stopwatchElapsedMs;
  const uint32_t totalSeconds = elapsed / 1000;
  const uint32_t hours = totalSeconds / 3600;
  const uint32_t minutes = (totalSeconds / 60) % 60;
  const uint32_t seconds = totalSeconds % 60;
  char buf[12];
  snprintf(buf, sizeof(buf), "%02lu:%02lu:%02lu", (unsigned long)hours, (unsigned long)minutes, (unsigned long)seconds);
  dma_display->clearScreen();
  render_clock_pattern(buf, dma_display->color565(255, 255, 255), (PANEL_RES_Y - 7) / 2);
  draw_stopwatch_ring(elapsed);
}

static void fill_color565(uint16_t c565) {
  for (int i=0; i<PANEL_RES_X*PANEL_RES_Y; i++) fb[i]=c565;
  draw_full_frame();
}

static void fade_frame(uint8_t factor) {
  for (int i=0; i<PANEL_RES_X*PANEL_RES_Y; i++) fb[i] = scale565(fb[i], factor);
}

static uint16_t fire_color(uint8_t heat) {
  uint8_t idx = heat > FIRE_MAX_INTENSITY ? FIRE_MAX_INTENSITY : heat;
  return firePalette[idx];
}

static EffectMode effectModeFromString(const char* mode) {
  if (!mode || !*mode) return FX_NONE;
  if (!strcmp(mode, "matrix")) return FX_MATRIX;
  if (!strcmp(mode, "fire")) return FX_FIRE;
  if (!strcmp(mode, "twinkle")) return FX_TWINKLE;
  if (!strcmp(mode, "plasma")) return FX_PLASMA;
  return FX_NONE;
}

static void init_effect_tables() {
  for (int i=0; i<256; i++) sinLUT[i] = (int16_t)(sinf((2.0f * PI * i) / 256.0f) * 127.0f);
  for (int i=0; i<64; i++) fxPalette[i] = hsv_to_565((i * 360) / 64, 255, 255);
  for (int y=0; y<PANEL_RES_Y; y++) {
    for (int x=0; x<PANEL_RES_X; x++) {
      int idx = y * PANEL_RES_X + x;
      float nx = (x - PANEL_RES_X / 2.0f);
      float ny = (y - PANEL_RES_Y / 2.0f);
      float a = atan2f(ny, nx);
      float d = sqrtf(nx*nx + ny*ny);
    }
  }
}

static void effectResetState(EffectMode mode) {
  if (mode == FX_MATRIX) {
    for (int x=0; x<PANEL_RES_X; x++) { matrixActive[x] = false; matrixPos[x] = 0; matrixLen[x] = 0; }
  } else if (mode == FX_FIRE) {
    memset(fireHeat, 0, sizeof(fireHeat));
    for (int x=0; x<PANEL_RES_X; x++) fireHeat[(PANEL_RES_Y - 1) * PANEL_RES_X + x] = FIRE_MAX_INTENSITY;
  } else if (mode == FX_TWINKLE) {
    memset(twinkleMap, 0, sizeof(twinkleMap));
  } else if (mode == FX_PLASMA) {
    plasmaPaletteShift = 0;
  }
}

static void effectStop() { effectRunning = false; effectMode = FX_NONE; effectNextMs = 0; }

static void stop_media_playback() {
  effectStop();
  animPlaying = false;
  if (animFile) animFile.close();
}

static void set_display_mode(DisplayMode mode) {
  if (displayMode == mode) return;
  displayMode = mode;
  clockNextMs = 0;
  stopwatchNextMs = 0;
  stop_media_playback();
}

static void reset_stopwatch(bool keepRunning) {
  stopwatchElapsedMs = 0;
  stopwatchStartMs = millis();
  stopwatchRunning = keepRunning;
}

static void fetch_weather_now() {
  if (WiFi.status() != WL_CONNECTED) {
    weatherValid = false;
    return;
  }
  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  if (!http.begin(client, WEATHER_URL)) {
    weatherValid = false;
    return;
  }
  int code = http.GET();
  if (code == HTTP_CODE_OK) {
    String payload = http.getString();
    StaticJsonDocument<512> doc;
    if (deserializeJson(doc, payload) == DeserializationError::Ok) {
      JsonObject current = doc["current_weather"].as<JsonObject>();
      if (!current.isNull()) {
        weatherTempC = current["temperature"] | weatherTempC;
        weatherCode = current["weathercode"] | weatherCode;
        weatherValid = true;
      } else {
        weatherValid = false;
      }
    } else {
      weatherValid = false;
    }
  } else {
    weatherValid = false;
  }
  http.end();
}

static void effectStart(EffectMode mode) {
  if (mode == FX_NONE) return;
  effectRunning = true;
  effectMode = mode;
  effectNextMs = 0;
  if (animPlaying) {
    animPlaying = false;
    if (animFile) animFile.close();
  }
  effectResetState(mode);
}

static void effectTickMatrix() {
  uint8_t fade = 255 - (uint16_t)effectParams.matrixTrail * 180 / 255;
  if (fade < 30) fade = 30;
  fade_frame(fade);
  uint8_t trailLen = 1 + (effectParams.matrixTrail / 32);
  uint16_t baseColor = scale565(effectParams.matrixColor, 220);
  for (int x=0; x<PANEL_RES_X; x++) {
    if (!matrixActive[x] && random(0, 256) < effectParams.matrixDensity) {
      matrixActive[x] = true; matrixPos[x] = 0; matrixLen[x] = trailLen;
    }
    if (matrixActive[x]) {
      int head = matrixPos[x];
      for (int t=0; t<=matrixLen[x]; t++) {
        int y = head - t;
        if (y < 0 || y >= PANEL_RES_Y) continue;
        uint8_t falloff = 255 - (uint16_t)t * 200 / (matrixLen[x] + 1);
        fb[y*PANEL_RES_X + x] = scale565(baseColor, falloff);
      }
      matrixPos[x]++;
      if (matrixPos[x] - matrixLen[x] > PANEL_RES_Y + 2) matrixActive[x] = false;
    }
  }
  draw_full_frame();
}

static void effectTickFire() {
  uint8_t decay = effectParams.fireDecay < 1 ? 1 : (effectParams.fireDecay > 6 ? 6 : effectParams.fireDecay);
  for (int y=0; y<PANEL_RES_Y-1; y++) {
    int row = y * PANEL_RES_X;
    int rowBelow = (y + 1) * PANEL_RES_X;
    for (int x=0; x<PANEL_RES_X; x++) {
      int xm1 = (x == 0) ? (PANEL_RES_X - 1) : (x - 1);
      int xp1 = (x == PANEL_RES_X - 1) ? 0 : (x + 1);
      int v = (fireHeat[rowBelow + x] + fireHeat[rowBelow + xm1] + fireHeat[rowBelow + xp1]) / 3;
      v -= random(0, decay + 1);
      if (v < 0) v = 0; if (v > FIRE_MAX_INTENSITY) v = FIRE_MAX_INTENSITY;
      fireHeat[row + x] = (uint8_t)v;
    }
  }
  for (int x=0; x<PANEL_RES_X; x++) {
    fireHeat[(PANEL_RES_Y - 1) * PANEL_RES_X + x] = (random(0,256) < effectParams.fireSparks) ? FIRE_MAX_INTENSITY : (FIRE_MAX_INTENSITY - decay);
  }
  uint8_t smoke = effectParams.fireSmoke;
  for (int i=0; i<PANEL_RES_X*PANEL_RES_Y; i++) fb[i] = scale565(fire_color(fireHeat[i]), 255 - smoke / 2);
  draw_full_frame();
}

static void effectTickTwinkle() {
  uint8_t fade = effectParams.twinkleFade < 2 ? 2 : effectParams.twinkleFade;
  fade_frame(255 - fade);
  uint16_t baseColor = effectParams.twinkleColor;
  for (int i=0; i<PANEL_RES_X*PANEL_RES_Y; i++) {
    if (random(0, 256) < effectParams.twinkleDensity) twinkleMap[i] = 255;
    if (twinkleMap[i] > 0) { fb[i] = scale565(baseColor, twinkleMap[i]); twinkleMap[i] = twinkleMap[i] > fade ? (twinkleMap[i] - fade) : 0; }
  }
  draw_full_frame();
}

static void effectTickPlasma() {
  static uint8_t t = 0;
  for (int y=0; y<PANEL_RES_Y; y++) {
    for (int x=0; x<PANEL_RES_X; x++) {
      int v = sinLUT[(uint8_t)(x * effectParams.plasmaAx + t)] + sinLUT[(uint8_t)(y * effectParams.plasmaAy + t)] + sinLUT[(uint8_t)((x + y) * effectParams.plasmaAxy + t)];
      uint8_t idx = (uint8_t)((v >> 2) & 63);
      fb[y*PANEL_RES_X + x] = fxPalette[(idx + plasmaPaletteShift) & 63];
    }
  }
  plasmaPaletteShift = (plasmaPaletteShift + effectParams.plasmaShiftSpeed) & 63;
  t++;
  draw_full_frame();
}

static void predrive_gpio_low(const HubPins& p) {
  const int pins[] = { p.r1,p.g1,p.b1,p.r2,p.g2,p.b2, p.a,p.b,p.c,p.d, p.clk,p.lat,p.oe };
  for (int pin: pins) {
    if(pin<0) continue;
    pinMode(pin, OUTPUT);
    digitalWrite(pin, LOW);
  }
}

static void init_display_with_pins(const HubPins& p) {
  predrive_gpio_low(p);
  delay(10);

  HUB75_I2S_CFG cfg(PANEL_RES_X, PANEL_RES_Y, PANEL_CHAIN);
  cfg.gpio.r1=p.r1; cfg.gpio.g1=p.g1; cfg.gpio.b1=p.b1;
  cfg.gpio.r2=p.r2; cfg.gpio.g2=p.g2; cfg.gpio.b2=p.b2;
  cfg.gpio.a=p.a; cfg.gpio.b=p.b; cfg.gpio.c=p.c; cfg.gpio.d=p.d; cfg.gpio.e=p.e;
  cfg.gpio.clk=p.clk; cfg.gpio.lat=p.lat; cfg.gpio.oe=p.oe;
  cfg.driver=p.driver; cfg.clkphase=p.clkphase; cfg.double_buff=p.double_buff;

  if(dma_display){ delete dma_display; dma_display=nullptr; delay(30); }
  dma_display = new MatrixPanel_I2S_DMA(cfg);
  dma_display->begin();
  apply_panel_brightness();
  dma_display->clearScreen();
  memset(fb,0,sizeof(fb));
}

static void reinit_display_now(){ init_display_with_pins(basePins); }

// =====================
// Animation player (RLE RGB565)
// =====================
static bool animOpenAndReadHeader() {
  if (!LittleFS.exists(ANIM_PATH)) return false;
  if (animFile) animFile.close();
  animFile = LittleFS.open(ANIM_PATH, "r");
  if (!animFile) return false;

  if (animFile.read((uint8_t*)&animHdr, sizeof(animHdr)) != sizeof(animHdr)) { animFile.close(); return false; }
  if (memcmp(animHdr.magic, "A64x", 4) != 0) { animFile.close(); return false; }
  if (animHdr.w != 64 || animHdr.h != 32 || animHdr.frames == 0) { animFile.close(); return false; }

  animFrameIndex=0; animNextMs=0;
  return true;
}

static bool animReadNextFrameAndRender(uint16_t &delayMsOut) {
  if (!animFile) return false;

  uint16_t delayMs=0;
  uint32_t rleLen=0;
  if (animFile.read((uint8_t*)&delayMs,2)!=2) return false;
  if (animFile.read((uint8_t*)&rleLen,4)!=4) return false;
  if (rleLen==0 || rleLen>250000) return false;

  static uint8_t* buf=nullptr;
  static size_t cap=0;
  if (rleLen>cap){
    free(buf);
    buf=(uint8_t*)malloc(rleLen);
    cap=rleLen;
    if(!buf) return false;
  }
  if (animFile.read(buf, rleLen) != (int)rleLen) return false;

  uint32_t bi=0, pi=0;
  while (bi+4<=rleLen && pi < PANEL_RES_X*PANEL_RES_Y) {
    uint16_t cnt = (uint16_t)(buf[bi] | (buf[bi+1]<<8));
    uint16_t col = (uint16_t)(buf[bi+2] | (buf[bi+3]<<8));
    bi += 4;
    uint32_t n=cnt;
    if (pi+n > PANEL_RES_X*PANEL_RES_Y) n = PANEL_RES_X*PANEL_RES_Y - pi;
    for (uint32_t k=0;k<n;k++) fb[pi++]=col;
  }

  draw_full_frame();
  delayMsOut = delayMs < 20 ? 20 : delayMs;
  return true;
}

// =====================
// Sleep schedule
// =====================
static bool is_sleep_time(const struct tm& timeinfo) {
  if (!sleepEnabled) return false;
  const int nowMinutes = timeinfo.tm_hour * 60 + timeinfo.tm_min;
  const int startMinutes = sleepStartHour * 60 + sleepStartMinute;
  const int endMinutes = sleepEndHour * 60 + sleepEndMinute;
  if (startMinutes == endMinutes) return false;
  if (startMinutes < endMinutes) {
    return nowMinutes >= startMinutes && nowMinutes < endMinutes;
  }
  return nowMinutes >= startMinutes || nowMinutes < endMinutes;
}

static uint8_t sleep_dim_percent() {
  if (!sleepActive) return 100;
  uint8_t percent = sleepDimPercent;
  if (percent > 20) percent = 20;
  return percent;
}

static void normalize_sleep_config() {
  if (sleepStartHour > 23) sleepStartHour = 23;
  if (sleepEndHour > 23) sleepEndHour = 23;
  if (sleepStartMinute > 59) sleepStartMinute = 59;
  if (sleepEndMinute > 59) sleepEndMinute = 59;
  if (sleepDimPercent > 20) sleepDimPercent = 20;
}

static void load_sleep_config() {
  normalize_sleep_config();
  if (!LittleFS.exists(SLEEP_CFG_PATH)) return;
  File cfg = LittleFS.open(SLEEP_CFG_PATH, "r");
  if (!cfg) return;
  StaticJsonDocument<256> doc;
  DeserializationError err = deserializeJson(doc, cfg);
  cfg.close();
  if (err) return;
  sleepEnabled = doc["enabled"] | sleepEnabled;
  sleepStartHour = doc["startHour"] | sleepStartHour;
  sleepStartMinute = doc["startMinute"] | sleepStartMinute;
  sleepEndHour = doc["endHour"] | sleepEndHour;
  sleepEndMinute = doc["endMinute"] | sleepEndMinute;
  sleepDimPercent = doc["dim"] | sleepDimPercent;
  normalize_sleep_config();
}

static void save_sleep_config() {
  normalize_sleep_config();
  StaticJsonDocument<256> doc;
  doc["enabled"] = sleepEnabled;
  doc["startHour"] = sleepStartHour;
  doc["startMinute"] = sleepStartMinute;
  doc["endHour"] = sleepEndHour;
  doc["endMinute"] = sleepEndMinute;
  doc["dim"] = sleepDimPercent;
  File cfg = LittleFS.open(SLEEP_CFG_PATH, "w");
  if (!cfg) return;
  serializeJson(doc, cfg);
  cfg.close();
}

static void apply_panel_brightness() {
  if (!dma_display) return;
  if (!sleepActive) {
    dma_display->setBrightness8(panelBrightness);
    return;
  }
  uint8_t percent = sleep_dim_percent();
  if (percent == 0) {
    dma_display->setBrightness8(0);
    return;
  }
  uint16_t scaled = (uint16_t)panelBrightness * percent / 100;
  if (scaled < 1) scaled = 1;
  if (scaled > 255) scaled = 255;
  dma_display->setBrightness8((uint8_t)scaled);
}

static void update_sleep_state() {
  if (!sleepEnabled) {
    if (sleepActive) {
      sleepActive = false;
      apply_panel_brightness();
    }
    return;
  }
  uint32_t now = millis();
  if (sleepNextCheckMs != 0 && (int32_t)(now - sleepNextCheckMs) < 0) return;
  sleepNextCheckMs = now + 30000;
  struct tm timeinfo;
  if (!getLocalTime(&timeinfo, 0)) return;
  bool shouldSleep = is_sleep_time(timeinfo);
  if (shouldSleep == sleepActive) return;
  sleepActive = shouldSleep;
  apply_panel_brightness();
  clockNextMs = 0;
  stopwatchNextMs = 0;
  animNextMs = 0;
  effectNextMs = 0;
}

// =====================
// WebSocket
// =====================
void onWsEvent(AsyncWebSocket*, AsyncWebSocketClient*, AwsEventType type, void *arg, uint8_t *data, size_t len) {
  if (type != WS_EVT_DATA) return;
  AwsFrameInfo *info = (AwsFrameInfo*)arg;

  if (info->opcode == WS_BINARY) {
    if (info->index + len > sizeof(frame_rx)) return;
    memcpy(frame_rx + info->index, data, len);
    if (info->final) {
      if (info->len == frame_rx_expected && frame_rx[0] == 0x46) {
        stop_media_playback();
        memcpy((uint8_t*)fb, frame_rx + 1, PANEL_RES_X*PANEL_RES_Y*2);
        draw_full_frame();
      }
    }
    return;
  }

  if (info->opcode != WS_TEXT || !info->final) return;

  JsonDocument doc;
  if (deserializeJson(doc, data, len)) return;
  const char* t = doc["t"] | "";

  if (!strcmp(t,"px")) {
    stop_media_playback();
    int x = doc["x"] | -1;
    int y = doc["y"] | -1;
    uint32_t c = doc["c"] | 0;
    if (x>=0 && x<PANEL_RES_X && y>=0 && y<PANEL_RES_Y) {
      uint16_t c565 = rgb888_to_565(c);
      fb[y*PANEL_RES_X + x] = c565;
      dma_display->drawPixel(x, y, c565);
    }
  } else if (!strcmp(t,"clear")) {
    stop_media_playback();
    memset(fb,0,sizeof(fb));
    dma_display->clearScreen();
  } else if (!strcmp(t,"fill")) {
    stop_media_playback();
    uint32_t ccol = doc["c"] | 0;
    fill_color565(rgb888_to_565(ccol));
  } else if (!strcmp(t,"stop")) {
    animPlaying = false;
    if (animFile) animFile.close();
  } else if (!strcmp(t,"fx")) {
    const char* modeStr = doc["mode"] | "";
    json_read_u16_clamped(doc["frameMs"], effectParams.frameMs, 20, 500);
    uint8_t p1 = clamp_u8(doc["p1"] | 0, 0, 255);
    uint8_t p2 = clamp_u8(doc["p2"] | 0, 0, 255);
    uint8_t p3 = clamp_u8(doc["p3"] | 0, 0, 255);
    uint8_t p4 = clamp_u8(doc["p4"] | 0, 0, 255);

    EffectMode requested = effectModeFromString(modeStr);
    if (requested != FX_NONE) effectMode = requested;
    switch (effectMode) {
      case FX_MATRIX: effectParams.matrixDensity = p1; effectParams.matrixTrail = p2; effectParams.matrixColor = rgb888_to_565((uint32_t)p3 << 8); break;
      case FX_FIRE: effectParams.fireDecay = p1; effectParams.fireSparks = p2; effectParams.fireSmoke = p3; break;
      case FX_TWINKLE: effectParams.twinkleDensity = p1; effectParams.twinkleFade = p2; effectParams.twinkleColor = rgb888_to_565(((uint32_t)p3 << 16) | ((uint32_t)p3 << 8) | p3); break;
      case FX_PLASMA: effectParams.plasmaAx = p1; effectParams.plasmaAy = p2; effectParams.plasmaAxy = p3; effectParams.plasmaShiftSpeed = p4; break;
      default: break;
    }

    int run = doc["run"] | -1;
    if (run == 0) effectStop();
    else if (run == 1) {
      set_display_mode(MODE_UI);
      if (effectMode == FX_NONE) effectMode = requested;
      effectStart(effectMode);
    }
  } else if (!strcmp(t,"mode")) {
    const char* modeStr = doc["mode"] | "ui";
    if (!strcmp(modeStr, "clock")) {
      set_display_mode(MODE_CLOCK);
    } else if (!strcmp(modeStr, "stopwatch")) {
      set_display_mode(MODE_STOPWATCH);
    } else {
      set_display_mode(MODE_UI);
    }
  } else if (!strcmp(t,"clockfmt")) {
    const char* fmt = doc["fmt"] | "hhmmss";
    clockShowSeconds = strcmp(fmt, "hhmm") != 0;
    clockNextMs = 0;
  } else if (!strcmp(t,"weather")) {
    int on = doc["on"] | 0;
    weatherEnabled = (on == 1);
    weatherNextMs = 0;
    if (!weatherEnabled) {
      weatherValid = false;
    }
  } else if (!strcmp(t,"clock")) {
    if (doc["c"].is<uint32_t>()) clockColor = doc["c"].as<uint32_t>();
    json_read_u8_clamped(doc["i"], clockIntensity, 10, 255);
    clockNextMs = 0;
  } else if (!strcmp(t,"stopwatch")) {
    if (doc["ring"].is<uint32_t>()) {
      stopwatchRingColor = rgb888_to_565(doc["ring"].as<uint32_t>());
    }
    int reset = doc["reset"] | 0;
    if (reset == 1) {
      reset_stopwatch(false);
    }
    if (doc["run"].is<int>()) {
      int run = doc["run"].as<int>();
      if (run == 1) {
        if (!stopwatchRunning) {
          stopwatchStartMs = millis() - stopwatchElapsedMs;
          stopwatchRunning = true;
        }
      } else if (run == 0) {
        if (stopwatchRunning) {
          stopwatchElapsedMs = millis() - stopwatchStartMs;
          stopwatchRunning = false;
        }
      }
    }
  } else if (!strcmp(t,"sleep")) {
    if (doc["on"].is<int>()) sleepEnabled = doc["on"].as<int>() == 1;
    json_read_u8_clamped(doc["sh"], sleepStartHour, 0, 23);
    json_read_u8_clamped(doc["sm"], sleepStartMinute, 0, 59);
    json_read_u8_clamped(doc["eh"], sleepEndHour, 0, 23);
    json_read_u8_clamped(doc["em"], sleepEndMinute, 0, 59);
    json_read_u8_clamped(doc["dim"], sleepDimPercent, 0, 100);
    normalize_sleep_config();
    save_sleep_config();
    sleepNextCheckMs = 0;
    update_sleep_state();
  } else if (!strcmp(t,"bright")) {
    panelBrightness = clamp_u8(doc["v"] | 5, 5, 255);
    apply_panel_brightness();
  }
}

// =====================
// WiFi
// =====================
void setup_wifi() {
  WiFi.mode(WIFI_STA);
  WiFi.begin(WIFI_SSID, WIFI_PASS);
  Serial.print("WiFi connecting");
  while (WiFi.status() != WL_CONNECTED) { delay(250); Serial.print("."); }
  Serial.println();
  Serial.print("IP: "); Serial.println(WiFi.localIP());
  if (MDNS.begin(MDNS_NAME)) {
    Serial.print("mDNS: http://"); Serial.print(MDNS_NAME); Serial.println(".local");
  }
}

void setup_time() {
  configTime(0, 0, NTP_SERVER);
  setenv("TZ", TZ_INFO, 1);
  tzset();
}

// =====================
// Server
// =====================
void setup_server() {
  ws.onEvent(onWsEvent);
  server.addHandler(&ws);

  server.on("/", HTTP_GET, [](AsyncWebServerRequest *req){
    req->send_P(200, "text/html; charset=utf-8", INDEX_HTML);
  });

  server.on("/api/reinit", HTTP_GET, [](AsyncWebServerRequest *req){
    reinit_display_now();
    req->send(200, "text/plain", "reinit ok");
  });

  server.on("/api/pixelart", HTTP_GET, [](AsyncWebServerRequest *req){
    if (!LittleFS.exists(PIXELART_PATH)) {
      req->send(404, "text/plain", "no pixelart");
      return;
    }
    req->send(LittleFS, PIXELART_PATH, "application/json");
  });

  server.on("/api/pixelart", HTTP_POST, [](AsyncWebServerRequest *req){
    req->send(200, "text/plain", "pixelart stored");
  });

  server.on("/api/sleep", HTTP_GET, [](AsyncWebServerRequest *req){
    StaticJsonDocument<256> doc;
    doc["enabled"] = sleepEnabled;
    doc["startHour"] = sleepStartHour;
    doc["startMinute"] = sleepStartMinute;
    doc["endHour"] = sleepEndHour;
    doc["endMinute"] = sleepEndMinute;
    doc["dim"] = sleepDimPercent;
    String payload;
    serializeJson(doc, payload);
    req->send(200, "application/json", payload);
  });

  server.on("/uploadAnim", HTTP_POST,
    [](AsyncWebServerRequest *req){ req->send(200, "text/plain", "stored"); },
    [](AsyncWebServerRequest*, String, size_t index, uint8_t *data, size_t len, bool final) {
      static File up;
      if (index == 0) {
        effectStop();
        animPlaying = false;
        if (animFile) animFile.close();
        up = LittleFS.open(ANIM_PATH, "w");
      }
      if (up) up.write(data, len);
      if (final && up) up.close();
    }
  );

  server.on("/api/anim/play", HTTP_GET, [](AsyncWebServerRequest *req){
    set_display_mode(MODE_UI);
    if (animOpenAndReadHeader()) {
      animPlaying = true;
      animNextMs = 0;
      req->send(200, "text/plain", "anim play");
    } else req->send(404, "text/plain", "no anim");
  });

  server.on("/api/anim/stop", HTTP_GET, [](AsyncWebServerRequest *req){
    animPlaying = false;
    if (animFile) animFile.close();
    req->send(200, "text/plain", "anim stop");
  });

  server.on("/ping", HTTP_GET, [](AsyncWebServerRequest *req){
    req->send(200, "text/plain", "pong");
  });

  server.begin();
  Serial.println("HTTP server started");
}

// =====================
// Arduino
// =====================
void setup() {
  Serial.begin(115200);
  delay(300);

  LittleFS.begin(true);
  load_sleep_config();

  init_display_with_pins(basePins);

  setup_wifi();
  setup_time();
  reinit_display_now(); // boot fix
  setup_server();
  init_effect_tables();

  dma_display->setTextSize(1);
  dma_display->setTextWrap(false);
  render_clock_frame();
}

void loop() {
  ws.cleanupClients();
  update_sleep_state();

  if (displayMode == MODE_CLOCK) {
    uint32_t now = millis();
    if (weatherEnabled && (weatherNextMs == 0 || (int32_t)(now - weatherNextMs) >= 0)) {
      fetch_weather_now();
      weatherNextMs = now + 600000;
    }
    if (clockNextMs == 0 || (int32_t)(now - clockNextMs) >= 0) {
      render_clock_frame();
      schedule_fixed_interval(clockNextMs, now, 1000);
    }
    delay(2);
    return;
  }

  if (displayMode == MODE_STOPWATCH) {
    uint32_t now = millis();
    if (stopwatchNextMs == 0 || (int32_t)(now - stopwatchNextMs) >= 0) {
      render_stopwatch_frame();
      schedule_fixed_interval(stopwatchNextMs, now, 200);
    }
    delay(2);
    return;
  }

  if (animPlaying) {
    uint32_t now = millis();
    if (animNextMs == 0 || (int32_t)(now - animNextMs) >= 0) {
      uint16_t delayMs = 100;
      bool ok = animReadNextFrameAndRender(delayMs);
      if (!ok) {
        if (animFile) animFile.close();
        if (animHdr.loop) {
          if (animOpenAndReadHeader()) animNextMs = now + 1;
          else animPlaying = false;
        } else animPlaying = false;
      } else {
        animFrameIndex++;
        if (animFrameIndex >= animHdr.frames) {
          if (animFile) animFile.close();
          if (animHdr.loop) animOpenAndReadHeader();
          else animPlaying = false;
        }
        schedule_fixed_interval(animNextMs, now, delayMs);
      }
    }
  }

  if (effectRunning) {
    uint32_t now = millis();
    uint16_t interval = effectParams.frameMs < 20 ? 20 : effectParams.frameMs;
    if (effectNextMs == 0 || (int32_t)(now - effectNextMs) >= 0) {
      switch (effectMode) {
        case FX_MATRIX: effectTickMatrix(); break;
        case FX_FIRE: effectTickFire(); break;
        case FX_TWINKLE: effectTickTwinkle(); break;
        case FX_PLASMA: effectTickPlasma(); break;
        default: break;
      }
      schedule_fixed_interval(effectNextMs, now, interval);
    }
  }

  delay(2);
}
